def qa_gate_permissions(profile: str) -> str:
    """Return the deliberately small, read-only gate allow-list for QA."""
    common = (
        '    "git diff --check*": allow\n'
        '    "git status --short*": allow'
    )
    profile_commands = {
        "flutter": (
            '    "dart format --output=none --set-exit-if-changed *": allow\n'
            '    "flutter analyze*": allow\n'
            '    "flutter test*": allow'
        ),
        "laravel": (
            '    "php artisan test*": allow\n'
            '    "./vendor/bin/pest*": allow\n'
            '    "./vendor/bin/phpunit*": allow\n'
            '    "./vendor/bin/pint --test*": allow'
        ),
        "kotlin-multiplatform": (
            '    "./gradlew test*": allow\n'
            '    "./gradlew :*test*": allow\n'
            '    "./gradlew detekt*": allow'
        ),
    }
    return "\n".join((common, profile_commands.get(profile, ""))).rstrip()


def opencode_agent(role: str, mode: str, model: str, read_only: bool = False, *, profile: str = "generic", provider: str, base_role: str | None = None) -> str:
    """Render one OpenCode role adapter with an explicit execution provider.

    `role` names the generated file (it may carry a `-<provider>` suffix for
    uniqueness). `base_role` is the engineering role (developer-low,
    reviewer, qa, ...) and `provider` the execution provider; both are
    passed explicitly by the generator. Nothing infers the provider from a
    name. The model ID itself is provider-qualified (`<provider>/<model>`).
    """
    resolved_base = base_role or role
    if resolved_base.startswith("qa-"):
        resolved_base = "qa"
    execution_provider = provider
    provider_guard = (
        f"For a dispatched task, require `PROVIDER: {execution_provider}` in the payload. "
        "If it names another provider, return `PROVIDER_MISMATCH` immediately; do not edit, run a gate, or retry."
        if resolved_base.startswith("developer") or resolved_base in {"reviewer", "reviewer-specialist", "qa"} else ""
    )
    if read_only:
        qa_bash = qa_gate_permissions(profile) if resolved_base == "qa" else '    "*": deny'
        permissions = '''permission:
  "*": deny
  read: allow
  glob: allow
  grep: allow
  list: allow
  skill: allow
  edit: deny
  task: deny
  bash:
{QA_BASH}'''.replace("{QA_BASH}", qa_bash)
    elif resolved_base == "orchestrator":
        # The Orchestrator is the single writer for canonical state/evidence,
        # not a second production implementer. Scope edits to feature artifacts.
        permissions = '''permission:
  read: allow
  glob: allow
  grep: allow
  list: allow
  skill: allow
  edit:
    "*": deny
    ".specs/**": allow
    "**/.specs/**": allow
  task: allow
  bash:
    "*": ask
    "git push*": deny
    "git reset*": deny
    "git clean*": deny
    "git rebase*": deny
    "git commit --amend*": deny'''
    elif resolved_base == "planner":
        # Planning is limited to edit-tool writes under .specs. Shell denial
        # prevents redirection from bypassing the production-file boundary.
        permissions = '''permission:
  read: allow
  glob: allow
  grep: allow
  list: allow
  skill: allow
  edit:
    "*": deny
    ".specs/**": allow
    "**/.specs/**": allow
  task: deny
  bash:
    "*": deny'''
    else:
        permissions = '''permission:
  read: allow
  glob: allow
  grep: allow
  list: allow
  skill: allow
  edit:
    "*": allow
    ".specs/**": deny
    "**/.specs/**": deny
  task: TASK_PERMISSION
  bash:
    "*": BASH_PERMISSION
    "*state.py*": deny
    "*routing.py*": deny
    "git push*": deny
    "git reset*": deny
    "git clean*": deny
    "git rebase*": deny
    "git commit --amend*": deny'''.replace("TASK_PERMISSION", "deny").replace("BASH_PERMISSION", "ask")
    instructions = {
        "orchestrator": "Own decomposition, dependencies, canonical state/evidence reconciliation, review loop, QA, and final integration. Delegate all production work; never edit production code. Every dispatch includes owned paths or a diff boundary. For formal tasks, honor the workflow provider selector. Resolve production with `resolve <tasks.md> <task> opencode --provider <name>`; resolve Reviewer/QA with `resolve-class opencode <reviewClasses|qaClasses> <class> --provider <name>`. Every returned JSON is a hard dispatch contract: call only `exec.agent`, include `PROVIDER: exec.provider` in the Task payload, and stop if its provider differs from the requested provider. The provider constraint applies to Developer, Reviewer, and QA. A global gate failure only outside that boundary is `EXTERNAL_DIRTY_WORKTREE`: it blocks clean-worktree release evidence, not the evaluated task; never ask QA to edit/revert it. A quota/rate-limit/unavailable error is terminal for that child: do not ask it to retry or wait indefinitely. Immediately resolve again with `--exclude-model <failed-model>` and dispatch only the next candidate, retaining a named provider; `auto` may change provider. If the active harness cannot cancel an already pending child, mark it cancelled/blocked in canonical state, dispatch no dependent work, and report the required UI cancellation. No candidate is a blocker. Resolve project gates from profile and project rules.",
        "planner": "Write only scoped specification, design, and task artifacts when required. Never edit canonical state/validation evidence, implement production code, or redefine project architecture.",
        "developer-low": "Implement one bounded low-complexity task and add relevant tests. Run discovered development gates for the task scope: format when it can change touched files, then analysis/lint and focused tests. Return compact gate evidence and Developer Closure facts to the Orchestrator; never write planning/state artifacts.",
        "developer": "Implement one bounded task and add relevant tests. Run discovered development gates for the task scope: format when it can change touched files, then analysis/lint and focused tests. Return compact gate evidence and Developer Closure facts to the Orchestrator; never write planning/state artifacts.",
        "developer-high": "Implement one bounded high-risk task. Assess integrity, concurrency, compatibility, rollback, and failures. Run the project-required development gates and return compact closure evidence to the Orchestrator; never write planning/state artifacts.",
        "developer-critical": "Implement one bounded critical-risk task. Escalate missing evidence or unsafe assumptions. Run the project-required development gates and return compact closure evidence to the Orchestrator; never write planning/state artifacts.",
        "reviewer": "Fresh independent reviewer. Read-only. Return ranked, evidence-bearing findings to the Orchestrator; never fix code or self-approve.",
        "reviewer-specialist": "Fresh independent specialist reviewer. Read-only. Review only the dispatched capability and return evidence to the Orchestrator.",
        "qa": "Independent QA. Read-only. Execute only approved non-mutating verification and evaluate acceptance/failure scenarios from executable evidence; request an exact scenario run from the Orchestrator when evidence is missing. Before global gates, inspect task-owned paths/diff and worktree status. A failure only outside the dispatched boundary is `EXTERNAL_DIRTY_WORKTREE`: report command/path/boundary and scoped evidence; do not call the task defective, edit/reformat/revert it, or claim a clean-worktree verdict. Missing ownership evidence is BLOCKED. Never format or edit source, specs, tasks, state, handoffs, or validation reports. Return QAResult only; the Orchestrator owns canonical artifacts.",
    }[resolved_base]
    return f'''---
description: "Shared {role} adapter; project policy remains external."
mode: {mode}
model: "{model}"
reasoningEffort: {role_effort(resolved_base)}
{permissions}
---

Route: harness=opencode provider={execution_provider} model="{model}" role={resolved_base}
Load the dispatched role capsule, current project AGENTS.md, and only the relevant shared protocol/profile sections.
{instructions}
{provider_guard}
Use Caveman handoffs: facts, paths, requirements, commands, results, risks, open items. Do not invent project commands or business rules.
'''


def codex_agent(role: str, model: str, effort: str, sandbox: str, description: str, instruction: str) -> str:
    return f'''name = "{role}"
description = "{description}"
model = "{model}"
model_reasoning_effort = "{effort}"
sandbox_mode = "{sandbox}"
developer_instructions = """
Load the dispatched role capsule, project AGENTS.md, and only relevant shared protocol/profile sections.
{instruction}
Use compact evidence. Never invent project gates, architecture, or domain policy.
"""
'''


def role_effort(role: str) -> str:
    if role.startswith("developer") or role in {"qa", "orchestrator"}:
        return "low"
    return "medium"


def portable_harness_routes(harness: str, default: str, *, strongest: str | None = None, cheapest: str | None = None) -> dict:
    strongest = strongest or default
    cheapest = cheapest or default
    def route(agent: str, model: str, effort: str) -> dict:
        return {"agent": agent, "model": model, "reasoningEffort": effort, "provider": harness}
    return {
        "schemaVersion": 1,
        "modelClasses": {
            "cost-efficient-coding": route("developer-low", cheapest, "low"),
            "balanced-coding": route("developer", default, "low"),
            "strong-coding": route("developer-high", strongest, "medium"),
            "strongest-appropriate": route("developer-high", strongest, "medium"),
        },
        "reviewClasses": {
            "independent-reviewer": route("reviewer", default, "medium"),
            "specialist-review": route("reviewer", strongest, "medium"),
        },
        "qaClasses": {
            "qa-basic": route("qa", cheapest, "low"),
            "qa-targeted": route("qa", default, "low"),
            "qa-adversarial": route("qa", strongest, "medium"),
        },
    }


def copilot_agent(role: str, model: str, effort: str, read_only: bool) -> str:
    restriction = "Read-only. Execute only approved non-mutating verification; do not edit files or project state." if role == "qa" else ("Do not edit files or project state." if read_only else "Respect the dispatched owned paths and project rules. Run discovered development gates before requesting review.")
    tools = "[read, search, execute]" if role == "qa" else ("[read, search]" if read_only else ("[read, search, agent, execute]" if role == "orchestrator" else "[read, search, edit, execute]"))
    model_line = "" if model == "auto" else f"model: {model}\n"
    return f'''---
name: {role}
description: Shared {role} adapter; project policy remains external.
{model_line}tools: {tools}
user-invocable: true
disable-model-invocation: true
---

Load the compact role capsule, project AGENTS.md, and only relevant managed protocol sections.
Requested effort is `{effort}` in the approved DispatchPlan; Copilot has no portable agent-frontmatter effort field, so verify the effective execution receipt.
{restriction}
Return facts, paths, commands, results, risks, and open items. Never persist reasoning or transcripts.
'''


def claude_agent(role: str, model: str, effort: str, read_only: bool) -> str:
    tools = "Read, Grep, Glob, Bash" if role == "qa" else ("Read, Grep, Glob" if read_only else ("Agent, Read, Grep, Glob, Bash" if role == "orchestrator" else "Read, Grep, Glob, Edit, Write, Bash"))
    restriction = "Read-only. Execute only approved non-mutating verification; never modify files or canonical state." if role == "qa" else ("Read-only. Never modify files or canonical state." if read_only else "Modify only the dispatched owned paths and run discovered development gates before review.")
    turn_limit = "" if role == "orchestrator" else "maxTurns: 8\n"
    return f'''---
name: {role}
description: Shared {role} adapter with compact context.
model: {model}
effort: {effort}
tools: {tools}
{turn_limit}---

Load the compact role capsule, project AGENTS.md, and only relevant managed protocol sections.
{restriction}
Return compact evidence without transcripts or hidden reasoning.
'''


def portable_workflow_prompt(workflow: str, description: str, harness: str) -> str:
    return f'''---
description: {json.dumps(description)}
---

{COMMAND_MARKER_START} workflow={workflow} -->
Load `.agent-managed/agent-engineering-framework/workflows/{workflow}.md`.
Before any agent dispatch, run `agent-kit {workflow} $ARGUMENTS --harness {harness} --propose --json`, present its model matrix, and wait for approval.
Dispatch only an approved plan and record the effective model/provider receipt.
Harness: {harness}. Project rules and canonical state remain external.
{COMMAND_MARKER_END}
'''


OPENCODE_STATIC_PROVIDERS = {"opencode", "openai"}
# Discovered-provider agent topology: portable class -> (agent base role, read-only).
# Agent files are named `<base>-<provider>.md`; the provider is always passed
# explicitly to opencode_agent, never inferred from the file name.
OPENCODE_EXTRA_AGENT_ROLES = {
    ("modelClasses", "cost-efficient-coding"): ("developer-low", False),
    ("modelClasses", "balanced-coding"): ("developer", False),
    ("modelClasses", "strong-coding"): ("developer-high", False),
    ("modelClasses", "strongest-appropriate"): ("developer-critical", False),
    ("reviewClasses", "independent-reviewer"): ("reviewer", True),
    ("reviewClasses", "specialist-review"): ("reviewer-specialist", True),
    ("qaClasses", "qa-basic"): ("qa-basic", True),
    ("qaClasses", "qa-targeted"): ("qa-targeted", True),
    ("qaClasses", "qa-adversarial"): ("qa-adversarial", True),
}
OPENCODE_CLASS_RANK = ("cost-efficient-coding", "balanced-coding", "strong-coding", "strongest-appropriate")


def opencode_extra_candidates(
    static_routing: dict,
    extra_models: list[dict],
) -> tuple[dict, list[tuple]]:
    """Append discovered-provider candidates to a parsed static routing map.

    Returns the extended map plus role files to generate as
    (agent, base_role, mode, model, readonly, provider). Models whose
    provider is statically covered, or already listed, are skipped so legacy
    output stays byte-identical when no extras apply.
    """
    known = {
        (option.get("provider"), option.get("model"))
        for family in ("modelClasses", "reviewClasses", "qaClasses")
        for entry in [static_routing.get(family, {})]
        if isinstance(entry, dict)
        for value in entry.values() if isinstance(value, dict)
        for option in (value.get("candidates") if isinstance(value.get("candidates"), list) else [value])
        if isinstance(option, dict)
    }
    assignments: dict[tuple[str, str, bool, str], list[dict]] = {}
    for item in extra_models:
        if not isinstance(item, dict) or not isinstance(item.get("id"), str):
            continue
        provider = str(item.get("provider") or "")
        model = item["id"]
        if not provider or provider in OPENCODE_STATIC_PROVIDERS or (provider, model) in known:
            continue
        classes = [value for value in (item.get("classes") or []) if isinstance(value, str)]
        targets = [
            (family, class_name) for family in ("modelClasses", "reviewClasses", "qaClasses")
            for class_name in classes
            if (family, class_name) in OPENCODE_EXTRA_AGENT_ROLES
        ]
        # Every discovered model is also a review/QA candidate: capability
        # floors (not candidacy) decide eligibility, so reviewer and QA
        # planes always have a provider-local pool to filter.
        for extra in (("reviewClasses", "independent-reviewer"), ("reviewClasses", "specialist-review"), ("qaClasses", "qa-basic"), ("qaClasses", "qa-targeted"), ("qaClasses", "qa-adversarial")):
            if extra not in targets:
                targets.append(extra)
        if not targets:
            targets = [("modelClasses", "balanced-coding")]
        for family, class_name in targets:
            base_role, readonly = OPENCODE_EXTRA_AGENT_ROLES[(family, class_name)]
            agent = f"{base_role}-{provider}"
            entry = static_routing.setdefault(family, {}).setdefault(class_name, {})
            candidates = entry.setdefault("candidates", [])
            if isinstance(candidates, list) and not any(
                isinstance(option, dict) and option.get("model") == model for option in candidates
            ):
                candidates.append({"agent": agent, "model": model, "provider": provider})
            assignments.setdefault((agent, base_role, readonly, provider), []).append(item)
    roles: list[tuple] = []
    for (agent, base_role, readonly, provider), items in sorted(assignments.items()):
        ranked = sorted(
            items,
            key=lambda item: max(
                [OPENCODE_CLASS_RANK.index(value) for value in (item.get("classes") or []) if value in OPENCODE_CLASS_RANK],
                default=-1,
            ),
            reverse=True,
        )
        representative = ranked[0]["id"]
        mode = "primary" if base_role == "orchestrator" else "subagent"
        roles.append((agent, base_role, mode, representative, readonly, provider))
    return static_routing, roles


def harness_templates(
    harness: str,
    *,
    profile: str = "generic",
    orchestrator_model: str | None = None,
    extra_models: list[dict] | None = None,
    allowed_providers: list[str] | None = None,
) -> dict[str, str]:
    if harness == "opencode":
        templates = {
            "opencode.json": json.dumps({"$schema": "https://opencode.ai/config.json", "default_agent": "orchestrator", "skills": {"paths": ["~/.agents/skills/tlc-spec-driven", "~/.agents/skills/caveman", ".agent-managed/agent-engineering-framework/skills"]}}, indent=2) + "\n",
            "gates.md": "# OpenCode gates adapter\n\nCanonical commands and policy: project rules, selected profile, and `docs/engineering-gates.md` when present. Do not define project commands here.\n",
            "routing.json": json.dumps({"schemaVersion": 1, "modelClasses": {"cost-efficient-coding": {"candidates": [{"agent": "developer-low", "model": "opencode/mimo-v2.5-free", "provider": "opencode"}, {"agent": "developer", "model": "opencode/big-pickle", "provider": "opencode"}, {"agent": "developer-low-openai", "model": "openai/gpt-5.6-luna", "provider": "openai"}]}, "balanced-coding": {"candidates": [{"agent": "developer", "model": "opencode/big-pickle", "provider": "opencode"}, {"agent": "developer-high", "model": "opencode/muse-spark-1.3-contributor-free", "provider": "opencode"}, {"agent": "developer-critical", "model": "opencode/nemotron-3-ultra-free", "provider": "opencode"}, {"agent": "developer-openai", "model": "openai/gpt-5.5", "provider": "openai"}]}, "strong-coding": {"candidates": [{"agent": "developer-high", "model": "opencode/muse-spark-1.3-contributor-free", "provider": "opencode"}, {"agent": "developer-critical", "model": "opencode/nemotron-3-ultra-free", "provider": "opencode"}, {"agent": "developer-high-openai", "model": "openai/gpt-5.6-sol", "provider": "openai"}]}, "strongest-appropriate": {"candidates": [{"agent": "developer-critical", "model": "opencode/nemotron-3-ultra-free", "provider": "opencode"}, {"agent": "developer-high", "model": "opencode/muse-spark-1.3-contributor-free", "provider": "opencode"}, {"agent": "developer-critical-openai", "model": "openai/gpt-6-astra", "provider": "openai"}]}}, "reviewClasses": {"independent-reviewer": {"candidates": [{"agent": "reviewer", "model": "opencode/nemotron-3-ultra-free", "provider": "opencode"}, {"agent": "reviewer-openai", "model": "openai/gpt-5.6-terra", "provider": "openai"}]}, "specialist-review": {"candidates": [{"agent": "reviewer-specialist", "model": "opencode/muse-spark-1.3-contributor-free", "provider": "opencode"}, {"agent": "reviewer-specialist-openai", "model": "openai/gpt-5.6-sol", "provider": "openai"}]}}, "qaClasses": {"qa-basic": {"candidates": [{"agent": "qa-basic", "model": "opencode/mimo-v2.5-free", "provider": "opencode"}, {"agent": "qa-basic-openai", "model": "openai/gpt-5.6-luna", "provider": "openai"}]}, "qa-targeted": {"candidates": [{"agent": "qa-targeted", "model": "opencode/big-pickle", "provider": "opencode"}, {"agent": "qa-targeted-openai", "model": "openai/gpt-5.5", "provider": "openai"}]}, "qa-adversarial": {"candidates": [{"agent": "qa-adversarial", "model": "opencode/nemotron-3-ultra-free", "provider": "opencode"}, {"agent": "qa-adversarial-openai", "model": "openai/gpt-5.6-sol", "provider": "openai"}]} }}, indent=2) + "\n",
        }
        selected_orchestrator = orchestrator_model or "opencode/nemotron-3-ultra-free"
        orchestrator_provider = model_catalog.normalize_provider(
            selected_orchestrator.split("/", 1)[0] if "/" in selected_orchestrator else "opencode", "opencode",
        )
        planner_model = "opencode/muse-spark-1.3-contributor-free"
        if allowed_providers is not None:
            if orchestrator_provider in allowed_providers:
                planner_model = selected_orchestrator
            elif extra_models:
                planner_model = extra_models[0]["id"]
        # (file role, base role, mode, model, read-only, provider): the
        # provider is explicit per entry; `-openai` is only a file-name
        # suffix preserved for backward compatibility.
        roles = (("orchestrator", "orchestrator", "primary", selected_orchestrator, False, orchestrator_provider), ("planner", "planner", "subagent", planner_model, False, model_catalog.normalize_provider(planner_model.split("/", 1)[0] if "/" in planner_model else "opencode", "opencode")), ("developer-low", "developer-low", "subagent", "opencode/mimo-v2.5-free", False, "opencode"), ("developer", "developer", "subagent", "opencode/big-pickle", False, "opencode"), ("developer-high", "developer-high", "subagent", "opencode/muse-spark-1.3-contributor-free", False, "opencode"), ("developer-critical", "developer-critical", "subagent", "opencode/nemotron-3-ultra-free", False, "opencode"), ("developer-low-openai", "developer-low", "subagent", "openai/gpt-5.6-luna", False, "openai"), ("developer-openai", "developer", "subagent", "openai/gpt-5.5", False, "openai"), ("developer-high-openai", "developer-high", "subagent", "openai/gpt-5.6-sol", False, "openai"), ("developer-critical-openai", "developer-critical", "subagent", "openai/gpt-6-astra", False, "openai"), ("reviewer", "reviewer", "subagent", "opencode/nemotron-3-ultra-free", True, "opencode"), ("reviewer-specialist", "reviewer-specialist", "subagent", "opencode/muse-spark-1.3-contributor-free", True, "opencode"), ("reviewer-openai", "reviewer", "subagent", "openai/gpt-5.6-terra", True, "openai"), ("reviewer-specialist-openai", "reviewer-specialist", "subagent", "openai/gpt-5.6-sol", True, "openai"), ("qa", "qa", "subagent", "opencode/mimo-v2.5-free", True, "opencode"), ("qa-basic", "qa-basic", "subagent", "opencode/mimo-v2.5-free", True, "opencode"), ("qa-targeted", "qa-targeted", "subagent", "opencode/big-pickle", True, "opencode"), ("qa-adversarial", "qa-adversarial", "subagent", "opencode/nemotron-3-ultra-free", True, "opencode"), ("qa-basic-openai", "qa-basic", "subagent", "openai/gpt-5.6-luna", True, "openai"), ("qa-targeted-openai", "qa-targeted", "subagent", "openai/gpt-5.5", True, "openai"), ("qa-adversarial-openai", "qa-adversarial", "subagent", "openai/gpt-5.6-sol", True, "openai"))
        if allowed_providers is not None:
            # Strict projects keep no executable route outside the allowed
            # providers: filter static candidates and drop disallowed role
            # files (orchestrator/planner always stay, on an allowed model).
            routing_map = json.loads(templates["routing.json"])
            for family_entries in routing_map.values():
                if not isinstance(family_entries, dict):
                    continue
                for entry in family_entries.values():
                    if isinstance(entry, dict) and isinstance(entry.get("candidates"), list):
                        entry["candidates"] = [
                            option for option in entry["candidates"]
                            if isinstance(option, dict) and option.get("provider") in allowed_providers
                        ]
            templates["routing.json"] = json.dumps(routing_map) + "\n"
            roles = tuple(
                entry for entry in roles
                if entry[5] in allowed_providers or entry[0] in ("orchestrator", "planner")
            )
        if extra_models:
            routing_map = json.loads(templates["routing.json"])
            routing_map, extra_roles = opencode_extra_candidates(routing_map, extra_models)
            templates["routing.json"] = json.dumps(routing_map) + "\n"
            roles = (*roles, *extra_roles)
        templates.update({f"agents/{file_role}.md": opencode_agent(file_role, mode, model, readonly, profile=profile, provider=provider, base_role=base_role) for file_role, base_role, mode, model, readonly, provider in roles})
        return templates
    if harness == "codex":
        routes = {
            "schemaVersion": 1,
            "modelClasses": {
                "cost-efficient-coding": {"agent": "developer-low", "model": "gpt-5.6-luna", "reasoningEffort": "low", "provider": "openai"},
                "balanced-coding": {"agent": "developer-medium", "model": "gpt-5.5", "reasoningEffort": "low", "provider": "openai"},
                "strong-coding": {"agent": "developer-high", "model": "gpt-5.6-sol", "reasoningEffort": "medium", "provider": "openai"},
                "strongest-appropriate": {"agent": "developer-high", "model": "gpt-5.6-sol", "reasoningEffort": "medium", "provider": "openai"},
            },
            "reviewClasses": {
                "independent-reviewer": {"agent": "reviewer", "model": "gpt-5.6-terra", "reasoningEffort": "medium", "provider": "openai"},
                "specialist-review": {"agent": "reviewer", "model": "gpt-5.6-sol", "reasoningEffort": "medium", "provider": "openai"},
            },
            "qaClasses": {
                "qa-basic": {"agent": "qa", "model": "gpt-5.6-luna", "reasoningEffort": "low", "provider": "openai"},
                "qa-targeted": {"agent": "qa", "model": "gpt-5.6-terra", "reasoningEffort": "low", "provider": "openai"},
                "qa-adversarial": {"agent": "qa", "model": "gpt-5.6-sol", "reasoningEffort": "low", "provider": "openai"},
            },
        }
        templates = {
            "config.toml": "# agent-framework-harness: codex-config\n[agents]\nenabled = true\nmax_concurrent_threads_per_session = 3\n",
            "routing.json": json.dumps(routes, indent=2) + "\n",
        }
        roles = (("orchestrator", orchestrator_model or "gpt-5.6-sol", "low", "workspace-write", "Shared task conductor.", "Own decomposition, dependencies, canonical state/evidence, review/verification, and final integration. Before dispatch, present the model-selection proposal and wait for approval. Delegate all production work; never edit production code."), ("planner", "gpt-5.6-sol", "medium", "workspace-write", "Shared specification planner.", "Write scoped planning artifacts only; never edit canonical state/validation evidence or production code."), ("developer_low", "gpt-5.6-luna", "low", "workspace-write", "Low-complexity task implementer.", "Implement one dispatched task and relevant tests. Run discovered format, analysis/lint, and focused tests where required before review; never edit .specs artifacts. Return compact closure evidence to the Orchestrator."), ("developer_medium", "gpt-5.5", "low", "workspace-write", "Medium-complexity task implementer.", "Implement one dispatched task and relevant tests. Run discovered development gates before review; never edit .specs artifacts. Return compact closure evidence to the Orchestrator."), ("developer_high", "gpt-5.6-sol", "medium", "workspace-write", "High-risk task implementer.", "Implement one dispatched task and relevant tests. Assess integrity, compatibility, concurrency, and rollback where relevant. Run project-required development gates and return compact closure evidence; never edit .specs artifacts."), ("reviewer", "gpt-5.6-terra", "medium", "read-only", "Independent read-only reviewer.", "Review independently; return one complete, evidence-bearing finding batch only. Never edit, self-approve, or write project artifacts."), ("qa", "gpt-5.6-luna", "low", "read-only", "Independent read-only QA.", "Execute approved non-mutating verification and evaluate acceptance/failure evidence independently. Never edit, format, refactor, or write project artifacts."))
        templates.update({f"agents/{role[0].replace('_', '-')}.toml": codex_agent(*role) for role in roles})
        return templates
    if harness == "copilot":
        routes = portable_harness_routes("copilot", "auto")
        templates = {
            "routing.json": json.dumps(routes, indent=2) + "\n",
            "instructions/agent-framework.instructions.md": "---\napplyTo: '**'\n---\nLoad project AGENTS.md and the managed engineering workflow. Use only the approved DispatchPlan and compact role capsule.\n",
        }
        for role, read_only in (("orchestrator", False), ("planner", False), ("developer-low", False), ("developer", False), ("developer-high", False), ("reviewer", True), ("qa", True)):
            effort = role_effort(role)
            model = orchestrator_model if role == "orchestrator" and orchestrator_model else "auto"
            templates[f"agents/{role}.agent.md"] = copilot_agent(role, model, effort, read_only)
        for workflow, description in WORKFLOWS.items():
            templates[f"prompts/{workflow}.prompt.md"] = portable_workflow_prompt(workflow, description, "copilot")
        return templates
    if harness == "claude":
        routes = portable_harness_routes("claude", "sonnet", strongest="opus", cheapest="haiku")
        templates = {"routing.json": json.dumps(routes, indent=2) + "\n"}
        role_models = {"orchestrator": orchestrator_model or "opus", "planner": "sonnet", "developer-low": "haiku", "developer": "sonnet", "developer-high": "opus", "reviewer": "sonnet", "qa": "haiku"}
        for role, model in role_models.items():
            templates[f"agents/{role}.md"] = claude_agent(role, model, role_effort(role), role in {"reviewer", "qa"})
        for workflow, description in WORKFLOWS.items():
            templates[f"commands/{workflow}.md"] = portable_workflow_prompt(workflow, description, "claude")
        return templates
    raise ValueError(harness)


def adapter_extra_models(harness: str, data: dict, catalog: dict | None) -> list[dict]:
    """Discovered-provider models missing from the static harness templates.

    Only providers in the manifest `allowed` list that the static templates
    do not cover (e.g. `copilot` under the `opencode` harness) produce
    extras. Projects without a `[provider]` block get no extras, so legacy
    generated output stays byte-identical.
    """
    if harness != "opencode" or not isinstance(catalog, dict):
        return []
    allowed = manifest_provider(data).get("allowed")
    if not allowed:
        return []
    models = catalog.get("harnesses", {}).get(harness, {}).get("models", [])
    if not isinstance(models, list):
        return []
    return [
        value for value in models
        if isinstance(value, dict)
        and isinstance(value.get("id"), str)
        and value.get("provider") in allowed
        and value.get("provider") not in OPENCODE_STATIC_PROVIDERS
        and value.get("available", True)
    ]


def adapter_template_options(harness: str, data: dict, catalog: dict | None) -> dict:
    """Template options binding the manifest provider policy to generation.

    Strict projects with an allowed list get executable routes only for
    those providers (static candidates filtered, discovered providers
    appended). Legacy projects without a policy get unfiltered templates
    and no extras.
    """
    policy = manifest_provider(data)
    strict_allowed = policy["allowed"] if policy.get("strict") else None
    return {
        "extra_models": adapter_extra_models(harness, data, catalog) or None,
        "allowed_providers": strict_allowed,
    }


def sync_harness_adapters(root: Path, data: dict, *, replace_managed: bool = False, extra_models: list[dict] | None = None, allowed_providers: list[str] | None = None) -> list[str]:
    if data.get("harness", {}).get("managed_adapters", True) is False:
        return []
    record_path = root / HARNESS_RECORD
    try:
        record = json.loads(record_path.read_text(encoding="utf-8")) if record_path.is_file() else {}
    except json.JSONDecodeError:
        if replace_managed:
            record = {}
        else:
            fail(f"invalid managed harness record: {record_path}")
    if not isinstance(record, dict):
        if replace_managed:
            record = {}
        else:
            fail(f"invalid managed harness record: {record_path}")
    planned: list[tuple[str, Path, bytes, bytes | None, str | None]] = []
    for harness in data["harnesses"]:
        harness_extras = [value for value in (extra_models or [])] if harness == "opencode" else None
        for relative, content in harness_templates(
            harness,
            profile=data["profile"],
            orchestrator_model=data.get("orchestrator_model") if harness == data["harnesses"][0] else None,
            extra_models=harness_extras,
            allowed_providers=allowed_providers,
        ).items():
            target_relative = (HARNESS_DIRS[harness] / relative).as_posix()
            target = root / target_relative
            expected = content.encode("utf-8")
            current = target.read_bytes() if target.is_file() else None
            known = record.get(target_relative)
            if current == expected:
                record[target_relative] = hashlib.sha256(expected).hexdigest()
                continue
            if current is not None:
                current_digest = hashlib.sha256(current).hexdigest()
                if known is not None and known != current_digest:
                    if not replace_managed:
                        fail(f"managed harness adapter modified: {target}; use `agent-kit sync --replace-managed` to back it up and restore the managed adapter, or move project extensions outside managed paths")
                if known is None:
                    backup_once(root, target, f"{harness}-{relative.replace('/', '-').replace('.', '_')}.before-agent-framework")
            planned.append((target_relative, target, expected, current, known))
    # Validate every managed target before writing any of them. A stale adapter
    # must never leave a consumer with a partially upgraded harness tree.
    for target_relative, target, _expected, current, known in planned:
        if current is not None and known is not None and known != hashlib.sha256(current).hexdigest() and replace_managed:
            backup_once(root, target, f"{target_relative.replace('/', '-').replace('.', '_')}.before-replace-managed")
    changed: list[str] = []
    for target_relative, target, expected, _current, _known in planned:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(expected)
        record[target_relative] = hashlib.sha256(expected).hexdigest()
        changed.append(target_relative)
    record_path.parent.mkdir(parents=True, exist_ok=True)
    record_path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return changed


def prune_obsolete_managed_adapters(root: Path, data: dict, extra_models: list[dict] | None = None, allowed_providers: list[str] | None = None) -> list[str]:
    """Remove only obsolete files named by the ownership ledger.

    Harness directories are never removed recursively, so project extensions in
    `.opencode`, `.codex`, `.github`, or `.claude` remain outside this operation.
    """
    record_path = root / HARNESS_RECORD
    try:
        record = json.loads(record_path.read_text(encoding="utf-8")) if record_path.is_file() else {}
    except json.JSONDecodeError:
        fail(f"invalid managed harness record: {record_path}")
    expected = {
        (HARNESS_DIRS[harness] / relative).as_posix()
        for harness in data["harnesses"]
        for relative in harness_templates(
            harness,
            profile=data["profile"],
            orchestrator_model=data.get("orchestrator_model") if harness == data["harnesses"][0] else None,
            extra_models=[value for value in (extra_models or [])] if harness == "opencode" else None,
            allowed_providers=allowed_providers,
        )
    }
    if "opencode" in data["harnesses"]:
        expected.update((Path(".opencode/commands") / f"{workflow}.md").as_posix() for workflow in WORKFLOWS)
    removed: list[str] = []
    for relative in sorted(set(record) - expected):
        candidate = Path(relative)
        if candidate.is_absolute() or ".." in candidate.parts or not any(candidate.is_relative_to(directory) for directory in HARNESS_DIRS.values()):
            fail(f"unsafe path in managed harness record: {relative}")
        target = root / candidate
        if target.is_file() or target.is_symlink():
            remove_path(target)
            removed.append(relative)
        record.pop(relative, None)
    record_path.parent.mkdir(parents=True, exist_ok=True)
    record_path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return removed


def fail(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(2)


def load_toml(path: Path) -> dict:
    if tomllib is None:
        return load_flat_toml(path)
    try:
        with path.open("rb") as stream:
            return tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"invalid TOML {path}: {error}")


def load_flat_toml(path: Path) -> dict:
    """Parse framework's deliberately small TOML subset on Python <3.11."""
    data: dict = {}
    node = data
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as error:
        fail(f"cannot read TOML {path}: {error}")
    for number, raw in enumerate(lines, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        section = re.fullmatch(r"\[([A-Za-z0-9_.-]+)\]", line)
        if section:
            node = data
            for part in section.group(1).split("."):
                node = node.setdefault(part, {})
            continue
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*=\s*(.+)", line)
        if not match:
            fail(f"invalid TOML {path}:{number}")
        key, raw_value = match.groups()
        if raw_value in {"true", "false"}:
            value: object = raw_value == "true"
        elif re.fullmatch(r'"(?:[^"\\]|\\.)*"', raw_value):
            value = raw_value[1:-1]
        elif raw_value.startswith("[") and raw_value.endswith("]"):
            items = raw_value[1:-1].strip()
            if not items:
                value = []
            else:
                values = [part.strip() for part in items.split(",")]
                if any(not re.fullmatch(r'"(?:[^"\\]|\\.)*"', item) for item in values):
                    fail(f"unsupported TOML array {path}:{number}")
                value = [item[1:-1] for item in values]
        else:
            fail(f"unsupported TOML value {path}:{number}")
        node[key] = value
    return data


def profile_path(profile: str) -> Path:
    path = FRAMEWORK / "profiles" / f"{profile}.md"
    if not path.is_file():
        fail(f"unknown profile: {profile}")
    return path


def manifest_path(root: Path) -> Path:
    return root / ".agent-framework.toml"


def parse_manifest(root: Path) -> dict:
    path = manifest_path(root)
    if not path.is_file():
        fail("missing .agent-framework.toml; run agent-kit init --profile <name>")
    data = load_toml(path)
    if str(data.get("framework_version", "")) != MAJOR:
        fail(f"framework major mismatch: project={data.get('framework_version')!r}, cli={MAJOR!r}")
    profile = data.get("profile")
    if not isinstance(profile, str):
        fail("manifest profile must be a string")
    profile_path(profile)
    harnesses = data.get("harnesses")
    if not isinstance(harnesses, list) or not harnesses or any(item not in SUPPORTED_HARNESSES for item in harnesses):
        fail("manifest harnesses must contain codex, opencode, copilot, or claude")
    harness_settings = data.get("harness", {})
    if harness_settings and (not isinstance(harness_settings, dict) or not isinstance(harness_settings.get("managed_adapters", True), bool)):
        fail("harness.managed_adapters must be boolean")
    state_settings = data.get("state", {})
    if state_settings:
        if not isinstance(state_settings, dict) or state_settings.get("provider", "framework") not in {"framework", "project"}:
            fail("state.provider must be framework or project")
        if "path" in state_settings and not isinstance(state_settings["path"], str):
            fail("state.path must be a string")
        if "command" in state_settings and not isinstance(state_settings["command"], str):
            fail("state.command must be a string")
    if not isinstance(data.get("ai_memory", True), bool):
        fail("manifest ai_memory must be boolean")
    if data.get("orchestrator_model") is not None and not isinstance(data.get("orchestrator_model"), str):
        fail("manifest orchestrator_model must be a string")
    provider_settings = data.get("provider", {})
    if provider_settings is None:
        provider_settings = {}
    if not isinstance(provider_settings, dict):
        fail("manifest provider must be a table")
    default_provider = provider_settings.get("default")
    allowed_providers = provider_settings.get("allowed")
    strict_provider = provider_settings.get("strict", default_provider is not None or allowed_providers is not None)
    if default_provider is not None and default_provider not in MANIFEST_PROVIDERS:
        fail(f"manifest provider.default must be one of {', '.join(MANIFEST_PROVIDERS)}")
    if allowed_providers is not None:
        if not isinstance(allowed_providers, list) or not allowed_providers or any(item not in MANIFEST_PROVIDERS for item in allowed_providers):
            fail(f"manifest provider.allowed must be a non-empty list of {', '.join(MANIFEST_PROVIDERS)}")
        if default_provider is not None and default_provider not in allowed_providers:
            fail("manifest provider.default must be listed in provider.allowed")
    if not isinstance(strict_provider, bool):
        fail("manifest provider.strict must be boolean")
    return data


def manifest_provider(manifest: dict) -> dict:
    """Normalized project provider policy with safe legacy defaults."""
    settings = manifest.get("provider") or {}
    if not isinstance(settings, dict):
        settings = {}
    default = settings.get("default")
    allowed = settings.get("allowed")
    strict = settings.get("strict", default is not None or allowed is not None)
    return {
        "default": default,
        "allowed": list(allowed) if isinstance(allowed, list) else None,
        "strict": bool(strict),
    }


def provider_block_text(default: str | None, allowed: list[str] | None, strict: bool) -> str:
    lines = ["[provider]"]
    if default is not None:
        lines.append(f"default = {json.dumps(default)}")
    if allowed is not None:
        lines.append("allowed = [" + ", ".join(json.dumps(item) for item in allowed) + "]")
    lines.append(f"strict = {'true' if strict else 'false'}")
    return "\n".join(lines) + "\n"


def replace_provider_block(text: str, default: str | None, allowed: list[str] | None, strict: bool) -> str:
    block = provider_block_text(default, allowed, strict)
    pattern = re.compile(r"^\[provider\].*?(?=^\[|\Z)", re.MULTILINE | re.DOTALL)
    if pattern.search(text):
        return pattern.sub(block, text, count=1)
    if not text.endswith("\n"):
        text += "\n"
    return text + "\n" + block


def replace_manifest_value(text: str, key: str, value: str) -> str:
    pattern = re.compile(rf"^{re.escape(key)}\s*=.*$", re.MULTILINE)
    if pattern.search(text):
        return pattern.sub(f"{key} = {value}", text, count=1)
    return f"{key} = {value}\n{text}"


def write_manifest(
    root: Path,
    profile: str,
    harnesses: list[str],
    *,
    force: bool = False,
    orchestrator_model: str | None = None,
    provider_default: str | None = None,
    provider_allowed: list[str] | None = None,
    provider_strict: bool | None = None,
    preserve_provider: bool = False,
) -> None:
    path = manifest_path(root)
    if path.exists():
        if not force:
            data = parse_manifest(root)
            if data["profile"] != profile:
                fail(f"existing profile is {data['profile']!r}; do not overwrite project manifest")
            return
        try:
            text = path.read_text(encoding="utf-8")
            load_toml(path)
        except (OSError, SystemExit):
            text = (FRAMEWORK / "templates/agent-framework.toml").read_text(encoding="utf-8")
    else:
        text = (FRAMEWORK / "templates/agent-framework.toml").read_text(encoding="utf-8")
    text = replace_manifest_value(text, "framework_version", f'"{MAJOR}"')
    text = replace_manifest_value(text, "profile", f'"{profile}"')
    text = replace_manifest_value(text, "harnesses", "[" + ", ".join(f'"{item}"' for item in harnesses) + "]")
    if orchestrator_model:
        text = replace_manifest_value(text, "orchestrator_model", json.dumps(orchestrator_model))
    if provider_default is not None or provider_allowed is not None or provider_strict is not None:
        if provider_default is not None and provider_default not in MANIFEST_PROVIDERS:
            fail(f"unsupported provider: {provider_default}")
        allowed = provider_allowed if provider_allowed is not None else ([provider_default] if provider_default else None)
        if allowed is not None and any(item not in MANIFEST_PROVIDERS for item in allowed):
            fail(f"unsupported provider in allowed list: {allowed}")
        if provider_default is not None and allowed is not None and provider_default not in allowed:
            fail("provider default must be listed in provider allowed")
        strict = provider_strict if provider_strict is not None else True
        text = replace_provider_block(text, provider_default, allowed, strict)
    elif preserve_provider:
        pass
    path.write_text(text, encoding="utf-8")


def normalize_identifier(value: str) -> str:
    normalized = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip("-._")
    return normalized or "project"


def git_remote_parts(root: Path) -> tuple[str | None, str | None]:
    try:
        top = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], cwd=root, text=True,
            capture_output=True, timeout=3, check=False,
        )
        if top.returncode != 0 or Path(top.stdout.strip()).resolve() != root.resolve():
            return None, None
        result = subprocess.run(
            ["git", "config", "--get", "remote.origin.url"],
            cwd=root,
            text=True,
            capture_output=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    remote = result.stdout.strip()
    if not remote:
        return None, None
    path = re.sub(r"^[A-Za-z][A-Za-z0-9+.-]*://[^/]+/", "", remote)
    path = re.sub(r"^[^@]+@[^:]+:", "", path).removesuffix(".git").strip("/")
    parts = [part for part in path.split("/") if part]
    return (parts[-2] if len(parts) > 1 else None, parts[-1] if parts else None)


def memory_identity(root: Path, workspace: str | None, project: str | None, *, interactive: bool = True) -> tuple[str, str, str]:
    remote_workspace, remote_project = git_remote_parts(root)
    suggested_workspace = normalize_identifier(remote_workspace or root.parent.name)
    suggested_project = normalize_identifier(remote_project or root.name)
    source = "flags" if workspace or project else ("git" if remote_project else "path")
    selected_workspace = normalize_identifier(workspace or suggested_workspace)
    selected_project = normalize_identifier(project or suggested_project)
    if interactive and sys.stdin.isatty():
        if workspace is None:
            selected_workspace = normalize_identifier(input(f"ai-memory workspace [{selected_workspace}]: ").strip() or selected_workspace)
        if project is None:
            selected_project = normalize_identifier(input(f"ai-memory project [{selected_project}]: ").strip() or selected_project)
    return selected_workspace, selected_project, source


def profile_memory_ignores(profile: str) -> tuple[str, ...]:
    additions = {
        "laravel": ("storage/oauth-private.key", "storage/oauth-public.key", "storage/**/*.key"),
        "flutter": ("android/key.properties", "android/**/*.jks", "android/**/*.keystore"),
        "kotlin-multiplatform": ("android/key.properties", "android/**/*.jks", "android/**/*.keystore"),
    }
    return additions.get(profile, ())


def render_ai_memory(root: Path, profile: str, workspace: str | None, project: str | None, *, interactive: bool = True) -> tuple[str, str]:
    selected_workspace, selected_project, source = memory_identity(root, workspace, project, interactive=interactive)
    text = (FRAMEWORK / "templates/ai-memory.toml").read_text(encoding="utf-8")
    text = text.replace("<workspace>", selected_workspace).replace("<project>", selected_project)
    additions = profile_memory_ignores(profile)
    if additions:
        rendered = "".join(f'    "{value}",\n' for value in additions)
        text = text.replace("    \"**/*.keystore\"\n]", "    \"**/*.keystore\",\n" + rendered.rstrip("\n,\n") + "\n]")
    return text, source


def ai_memory_validation(path: Path) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    if not path.is_file():
        return [".ai-memory.toml missing; run agent-kit sync"], warnings
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        return [f"cannot read .ai-memory.toml: {error}"], warnings
    if tomllib is not None:
        try:
            with path.open("rb") as stream:
                data = tomllib.load(stream)
        except (OSError, tomllib.TOMLDecodeError) as error:
            return [f"invalid .ai-memory.toml: {error}"], warnings
        for key in AI_MEMORY_REQUIRED:
            value = data.get(key)
            if value is None or value == "":
                errors.append(f".ai-memory.toml missing {key}")
    else:  # Strict validation for the template subset on Python 3.9/3.10.
        in_array = False
        for number, raw in enumerate(text.splitlines(), 1):
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            if in_array:
                if line == "]":
                    in_array = False
                elif not re.fullmatch(r'"(?:[^"\\]|\\.)*",?', line):
                    errors.append(f"invalid .ai-memory.toml:{number}")
                continue
            if re.fullmatch(r"\[[A-Za-z0-9_.-]+\]", line):
                continue
            assignment = re.fullmatch(r"[A-Za-z0-9_-]+\s*=\s*(.+)", line)
            if not assignment:
                errors.append(f"invalid .ai-memory.toml:{number}")
                continue
            raw_value = assignment.group(1).strip()
            if raw_value == "[":
                in_array = True
            elif not (
                re.fullmatch(r'"(?:[^"\\]|\\.)*"', raw_value)
                or raw_value in {"true", "false"}
                or re.fullmatch(r"\d+", raw_value)
            ):
                errors.append(f"invalid .ai-memory.toml:{number}")
        if in_array:
            errors.append("invalid .ai-memory.toml: unterminated array")
        for key in AI_MEMORY_REQUIRED:
            if not re.search(rf"^{re.escape(key)}\s*=\s*(?:\"[^\"]+\"|true)\s*$", text, re.MULTILINE):
                errors.append(f".ai-memory.toml missing {key}")
    lowered = text.lower()
    if '".env"' not in lowered or "secret" not in lowered or not any(ext in lowered for ext in ("*.pem", "*.key", "*.jks", "*.keystore")):
        warnings.append(".ai-memory.toml capture.ignore_paths lacks recommended secret protections")
    return errors, warnings


def ensure_ai_memory_config(root: Path, data: dict, args: argparse.Namespace) -> tuple[str, str | None]:
    if data.get("ai_memory", True) is False:
        return "disabled", None
    path = root / AI_MEMORY_FILE
    if path.exists():
        errors, _warnings = ai_memory_validation(path)
        return ("invalid", "; ".join(errors)) if errors else ("preserved", None)
    text, source = render_ai_memory(
        root,
        data["profile"],
        getattr(args, "memory_workspace", None),
        getattr(args, "memory_project", None),
        interactive=not bool(getattr(args, "yes", False)),
    )
    path.write_text(text, encoding="utf-8")
    return "created", source


def ensure_model_catalog(root: Path, data: dict, args: argparse.Namespace, *, force: bool = False) -> tuple[str, dict]:
    lock = root / model_catalog.LOCK_PATH
    reuse = bool(getattr(args, "reuse_model_lock", False))
    refresh = bool(getattr(args, "refresh_models", False) or getattr(args, "discover_models", False))
    if lock.is_file() and (reuse or (not force and not refresh)):
        try:
            value = model_catalog.load_catalog(root)
            errors = model_catalog.validate_catalog(value, data["harnesses"])
            if not errors:
                return "reused" if reuse else "preserved", value
        except ValueError:
            if reuse:
                fail("--reuse-model-lock requires a valid lock for every selected harness")
    discover = bool(getattr(args, "discover_models", False) or sys.stdin.isatty())
    value = model_catalog.build_catalog(root, data["harnesses"], discover=discover)
    errors = model_catalog.validate_catalog(value, data["harnesses"])
    if errors:
        fail(missing_provider_models_error(data["harnesses"], value, data.get("provider")) or "; ".join(errors))
    model_catalog.write_catalog(root, value)
    return "refreshed" if force or refresh else "created", value


def select_orchestrator_model(root: Path, data: dict, catalog: dict, requested: str | None) -> str:
    configured = requested or data.get("orchestrator_model")
    primary = data["harnesses"][0]
    policy = manifest_provider(data)
    allowed = policy.get("allowed")
    models = catalog.get("harnesses", {}).get(primary, {}).get("models", [])
    available = [value for value in models if isinstance(value, dict) and value.get("available", True)]
    if allowed:
        available = [value for value in available if value.get("provider") in allowed]
    if configured:
        match = next((value for value in available if value.get("id") == configured), None)
        if match is None:
            if allowed and any(
                isinstance(value, dict) and value.get("id") == configured and value.get("available", True)
                for value in models
            ):
                fail(f"PROVIDER_MISMATCH: {configured!r} is not in the allowed providers {allowed}")
            fail(f"ORCHESTRATOR_UNAVAILABLE: {configured!r} is not available in control harness {primary}")
        classes = match.get("classes", [])
        if not any(value in {"strong-coding", "strongest-appropriate"} for value in classes):
            fail(f"orchestrator model {configured!r} is below the strong control-plane floor")
        return str(configured)
    mapping = json.loads((root / HARNESS_DIRS[primary] / "routing.json").read_text(encoding="utf-8"))
    entry = mapping.get("modelClasses", {}).get("strongest-appropriate", {})
    candidates = entry.get("candidates") if isinstance(entry, dict) else None
    options = candidates if isinstance(candidates, list) else [entry]
    if allowed:
        options = [
            option for option in options
            if isinstance(option, dict) and (option.get("provider") in allowed or "provider" not in option)
        ]
    for option in options:
        if isinstance(option, dict) and any(value.get("id") == option.get("model") for value in available):
            return str(option["model"])
    if allowed:
        eligible = [value for value in available if any(
            cls in {"strong-coding", "strongest-appropriate"} for cls in (value.get("classes") or [])
        )]
        if eligible:
            by_class = {"strongest-appropriate": 1, "strong-coding": 0}
            eligible.sort(key=lambda value: (
                max([by_class.get(cls, -1) for cls in (value.get("classes") or [])], default=-1),
                str(value.get("id")),
            ), reverse=True)
            return str(eligible[0]["id"])
        fail(f"ORCHESTRATOR_UNAVAILABLE: no allowed {allowed} model meets the strong control-plane floor for {primary}")
    fail(f"ORCHESTRATOR_UNAVAILABLE: no strongest-appropriate model for control harness {primary}")


def persist_orchestrator_model(root: Path, model: str) -> None:
    path = manifest_path(root)
    text = path.read_text(encoding="utf-8")
    updated = replace_manifest_value(text, "orchestrator_model", json.dumps(model))
    if updated != text:
        path.write_text(updated, encoding="utf-8")


def preflight_reinstall_catalog(
    root: Path,
    profile: str,
    harnesses: list[str],
    args: argparse.Namespace,
    configured_orchestrator: str | None,
    provider_policy: dict | None = None,
) -> tuple[dict, str, str]:
    """Stage harness mappings and validate model availability before project writes."""
    if args.reuse_model_lock:
        try:
            value = model_catalog.load_catalog(root)
        except ValueError as error:
            fail(f"--reuse-model-lock requires a valid lock: {error}")
        errors = model_catalog.validate_catalog(value, harnesses)
        if errors:
            fail("--reuse-model-lock: " + "; ".join(errors))
        status = "reused"
    else:
        value = None
        status = "refreshed"
    with tempfile.TemporaryDirectory(prefix="agent-kit-reinstall-") as raw:
        staged = Path(raw)
        for harness in harnesses:
            staged_allowed = provider_policy["allowed"] if provider_policy and harness == "opencode" else None
            for relative, content in harness_templates(harness, profile=profile, allowed_providers=staged_allowed).items():
                target = staged / HARNESS_DIRS[harness] / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(content, encoding="utf-8")
        if value is None:
            discover = bool(args.discover_models or sys.stdin.isatty())
            value = model_catalog.build_catalog(staged, harnesses, discover=discover)
            errors = model_catalog.validate_catalog(value, harnesses)
            if errors:
                hint = missing_provider_models_error(harnesses, value, provider_policy)
                fail("reinstall model preflight failed: " + (hint or "; ".join(errors)))
        selected = select_orchestrator_model(
            staged,
            {"harnesses": harnesses, **({"provider": provider_policy} if provider_policy else {})},
            value,
            args.orchestrator_model or configured_orchestrator,
        )
        return value, status, selected


def managed_block() -> str:
    return (FRAMEWORK / "templates/agents-managed-block.md").read_text(encoding="utf-8").strip()


def sync_agents(root: Path, backup: bool, *, force: bool = False) -> bool:
    path = root / "AGENTS.md"
    if path.exists():
        original = path.read_text(encoding="utf-8")
    else:
        original = ""
    starts, ends = original.count(MARKER_START), original.count(MARKER_END)
    if starts != ends or starts > 1:
        if not force:
            fail("AGENTS.md has malformed or duplicate agent-framework markers")
        original = re.sub(
            re.escape(MARKER_START) + r"[\s\S]*?" + re.escape(MARKER_END),
            "",
            original,
        ).replace(MARKER_START, "").replace(MARKER_END, "")
        starts = ends = 0
    block = managed_block()
    if starts == 1:
        before, rest = original.split(MARKER_START, 1)
        _, after = rest.split(MARKER_END, 1)
        updated = before.rstrip() + "\n\n" + block + after
    else:
        if backup and path.exists():
            backups = root / ".agent-managed/backups"
            backups.mkdir(parents=True, exist_ok=True)
            backup_path = backups / "AGENTS.md.before-agent-framework"
            if not backup_path.exists():
                backup_path.write_text(original, encoding="utf-8")
        updated = (original.rstrip() + "\n\n" if original.strip() else "") + block + "\n"
    if updated != original:
        path.write_text(updated, encoding="utf-8")
        return True
    return False


def project_workflow_hook(data: dict, workflow: str) -> str | None:
    workflows = data.get("workflows", {})
    if not isinstance(workflows, dict):
        return None
    settings = workflows.get(workflow, {})
    if not isinstance(settings, dict):
        return None
    hook = settings.get("after")
    if hook is not None and not isinstance(hook, str):
        fail(f"workflows.{workflow}.after must be a string")
    return hook


def configured_providers(root: Path, harness: str) -> list[str]:
    path = root / HARNESS_DIRS[harness] / "routing.json"
    try:
        mapping = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    providers: set[str] = set()
    for family in ("modelClasses", "reviewClasses", "qaClasses"):
        routes = mapping.get(family, {}) if isinstance(mapping, dict) else {}
        if not isinstance(routes, dict):
            continue
        for route in routes.values():
            if not isinstance(route, dict):
                continue
            candidates = route.get("candidates")
            options = candidates if isinstance(candidates, list) else [route]
            for option in options:
                provider = option.get("provider") if isinstance(option, dict) else None
                if isinstance(provider, str) and provider:
                    providers.add(provider)
    return sorted(providers)


def managed_command(workflow: str, description: str, hook: str | None = None) -> str:
    lines = [
        "---",
        f"description: {json.dumps(description)}",
        "agent: orchestrator",
        "---",
        "",
        f"<!-- agent-framework-command:start workflow={workflow} -->",
        f"Load `.agent-managed/agent-engineering-framework/workflows/{workflow}.md`.",
        "Load only the relevant engineering-protocol, profile, and project rules it routes to.",
        "This is a generated adapter; do not redefine workflow semantics here.",
        "Intent or feature reference: `$ARGUMENTS`.",
        "Optional execution-provider selector: `<feature-or-intent> [auto|openai|opencode|openrouter|copilot|claude]` or `--provider=<name>`.",
        f"Before any Task dispatch, run `agent-kit {workflow} $ARGUMENTS --harness opencode --propose --json`, present the proposal, and dispatch only an explicitly approved DispatchPlan.",
        "Provider is a hard dispatch constraint: resolve before Task; dispatch only the exact returned `exec.agent` with `PROVIDER: exec.provider`. If this cannot be done, stop without a production dispatch.",
    ]
    if hook:
        lines.append(f"Project-owned post-workflow hook: `{hook}`.")
    lines.extend((COMMAND_MARKER_END, ""))
    return "\n".join(lines)


def managed_codex_prompt(workflow: str, description: str) -> str:
    return "\n".join((
        "---",
        f"description: {json.dumps(description)}",
        "argument-hint: <intent-or-feature-id>",
        "---",
        "",
        f"<!-- agent-framework-command:start workflow={workflow} -->",
        f"In the current repository, load `.agent-managed/agent-engineering-framework/workflows/{workflow}.md`.",
        "Load only the relevant engineering-protocol, profile, and project rules it routes to.",
        "This is a generated adapter; do not redefine workflow semantics here.",
        "Intent or feature reference: `$ARGUMENTS`.",
        "Optional execution-provider selector: `<feature-or-intent> [auto|openai|opencode|openrouter|copilot|claude]` or `--provider=<name>`.",
        f"Before any subagent dispatch, run `agent-kit {workflow} $ARGUMENTS --harness codex --propose --json`, present the proposal, and dispatch only an explicitly approved DispatchPlan.",
        COMMAND_MARKER_END,
        "",
    ))


def backup_once(root: Path, source: Path, name: str) -> None:
    backup = root / ".agent-managed" / "backups" / name
    backup.parent.mkdir(parents=True, exist_ok=True)
    if not backup.exists() and source.exists():
        backup.write_text(source.read_text(encoding="utf-8"), encoding="utf-8")


def sync_opencode_commands(root: Path, data: dict, backup: bool, *, force: bool = False) -> list[str]:
    enabled = "opencode" in data["harnesses"]
    if not enabled:
        return []
    changed: list[str] = []
    commands = root / ".opencode" / "commands"
    record_path = root / HARNESS_RECORD
    try:
        record = json.loads(record_path.read_text(encoding="utf-8")) if record_path.is_file() else {}
    except json.JSONDecodeError:
        fail(f"invalid managed harness record: {record_path}")
    if not isinstance(record, dict):
        fail(f"invalid managed harness record: {record_path}")
    for workflow, description in WORKFLOWS.items():
        target = commands / f"{workflow}.md"
        target_relative = target.relative_to(root).as_posix()
        expected = managed_command(workflow, description, project_workflow_hook(data, workflow))
        current = target.read_text(encoding="utf-8") if target.exists() else ""
        owned = COMMAND_MARKER_START in current and COMMAND_MARKER_END in current
        if target.exists() and not owned:
            if not backup and not force:
                fail(f"refusing to replace unmanaged OpenCode command: {target}")
            backup_once(root, target, f"opencode-{workflow}.md.before-agent-framework")
        if current != expected:
            commands.mkdir(parents=True, exist_ok=True)
            target.write_text(expected, encoding="utf-8")
            changed.append(workflow)
        record[target_relative] = hashlib.sha256(expected.encode("utf-8")).hexdigest()
    record_path.parent.mkdir(parents=True, exist_ok=True)
    record_path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return changed


def sync_codex_prompts() -> list[str]:
    """Codex custom prompts are global by harness design, not project files."""
    prompts = Path.home() / ".codex" / "prompts"
    changed: list[str] = []
    for workflow, description in WORKFLOWS.items():
        target = prompts / f"{workflow}.md"
        expected = managed_codex_prompt(workflow, description)
        current = target.read_text(encoding="utf-8") if target.exists() else ""
        owned = COMMAND_MARKER_START in current and COMMAND_MARKER_END in current
        if target.exists() and not owned:
            print(f"WARN: leaving unmanaged Codex prompt: {target}")
            continue
        if current != expected:
            prompts.mkdir(parents=True, exist_ok=True)
            target.write_text(expected, encoding="utf-8")
            changed.append(workflow)
    return changed


def copy_assets(root: Path, profile: str, *, force: bool = False) -> None:
    destination = root / MANAGED_REL
    parent = destination.parent
    parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=parent, prefix=".aef-sync-") as raw_temp:
        temp = Path(raw_temp) / "agent-engineering-framework"
        temp.mkdir()
        for folder in ASSET_DIRS:
            source = FRAMEWORK / folder
            target = temp / folder
            if folder == "profiles":
                target.mkdir()
                shutil.copy2(source / "generic.md", target / "generic.md")
                shutil.copy2(source / f"{profile}.md", target / f"{profile}.md")
            else:
                shutil.copytree(source, target)
        (temp / "VERSION").write_text(VERSION + "\n", encoding="utf-8")
        digest = tree_digest(temp)
        (temp / "metadata.toml").write_text(
            f'framework_version = "{VERSION}"\nframework_major = "{MAJOR}"\ncontent_sha256 = "{digest}"\n',
            encoding="utf-8",
        )
        previous = parent / ".agent-engineering-framework.previous"
        if previous.exists():
            shutil.rmtree(previous)
        if destination.exists():
            if not (destination / "metadata.toml").is_file():
                if not force:
                    fail(f"refusing to replace unmanaged directory: {destination}")
                remove_path(destination)
            else:
                os.replace(destination, previous)
        os.replace(temp, destination)
        if previous.exists():
            shutil.rmtree(previous)


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        if path.is_file() and path.name != "metadata.toml":
            digest.update(path.relative_to(root).as_posix().encode())
            digest.update(path.read_bytes())
    return digest.hexdigest()


def expected_digest(profile: str) -> str:
    with tempfile.TemporaryDirectory(prefix="aef-digest-") as raw:
        temporary_root = Path(raw)
        copy_assets(temporary_root, profile)
        return tree_digest(temporary_root / MANAGED_REL)


def remove_path(path: Path) -> None:
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    elif path.exists() or path.is_symlink():
        path.unlink()


def reinstall_paths(root: Path, harnesses: list[str], extra_models: list[dict] | None = None, allowed_providers: list[str] | None = None) -> list[Path]:
    paths = {
        root / ".agent-framework.toml",
        root / "AGENTS.md",
        root / AI_MEMORY_FILE,
        root / MANAGED_REL,
        root / HARNESS_RECORD,
        root / model_catalog.LOCK_PATH,
    }
    try:
        record = json.loads((root / HARNESS_RECORD).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        record = {}
    if isinstance(record, dict):
        for relative in record:
            if isinstance(relative, str) and relative and not Path(relative).is_absolute() and ".." not in Path(relative).parts:
                paths.add(root / relative)
    for harness in harnesses:
        for relative in harness_templates(
            harness,
            extra_models=[value for value in (extra_models or [])] if harness == "opencode" else None,
            allowed_providers=allowed_providers,
        ).keys():
            paths.add(root / HARNESS_DIRS[harness] / relative)
    for workflow in WORKFLOWS:
        paths.add(root / ".opencode" / "commands" / f"{workflow}.md")
    return sorted(paths, key=lambda value: (len(value.parts), str(value)))


def create_reinstall_backup(root: Path, paths: list[Path]) -> tuple[Path, dict[str, str]]:
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    backup = root / ".agent-managed" / "backups" / f"reinstall-{stamp}"
    files = backup / "files"
    inventory: dict[str, str] = {}
    for path in paths:
        try:
            relative = path.relative_to(root)
        except ValueError:
            continue
        key = relative.as_posix()
        if path.is_dir() and not path.is_symlink():
            target = files / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(path, target)
            inventory[key] = "directory"
        elif path.exists() or path.is_symlink():
            target = files / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, target)
            inventory[key] = "file"
        else:
            inventory[key] = "missing"
    backup.mkdir(parents=True, exist_ok=True)
    (backup / "inventory.json").write_text(json.dumps(inventory, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return backup, inventory


def restore_reinstall_backup(root: Path, backup: Path, inventory: dict[str, str]) -> None:
    files = backup / "files"
    for relative in sorted(inventory, key=lambda value: len(Path(value).parts), reverse=True):
        remove_path(root / relative)
    for relative, kind in inventory.items():
        if kind == "missing":
            continue
        source = files / relative
        target = root / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        if kind == "directory":
            shutil.copytree(source, target)
        else:
            shutil.copy2(source, target)


def config_path() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-kit" / "framework.toml"


def shell_profile_path(*, home: Path | None = None, shell: str | None = None) -> Path | None:
    base = home or Path.home()
    shell_name = Path(shell or os.environ.get("SHELL", "")).name
    if shell_name == "zsh":
        return base / ".zshrc"
    if shell_name == "bash":
        return base / ".bash_profile"
    return None


def ensure_agent_kit_shell_path(
    *,
    home: Path | None = None,
    shell: str | None = None,
    interactive: bool | None = None,
) -> tuple[str, str | None]:
    """Offer one init-only, project-independent PATH bootstrap."""
    profile = shell_profile_path(home=home, shell=shell)
    if profile is None:
        return "unsupported", Path(shell or os.environ.get("SHELL", "unknown")).name
    try:
        text = profile.read_text(encoding="utf-8") if profile.is_file() else ""
    except (OSError, UnicodeError) as error:
        return "error", str(error)
    binary_dir = str(FRAMEWORK / "bin")
    if any(
        binary_dir in line
        and line.strip().startswith(("export PATH=", "PATH="))
        and not line.lstrip().startswith("#")
        for line in text.splitlines()
    ):
        return "preserved", str(profile)
    starts = text.count(SHELL_PATH_MARKER_START)
    ends = text.count(SHELL_PATH_MARKER_END)
    if starts or ends:
        return "invalid", f"malformed or stale managed markers in {profile}"
    is_interactive = sys.stdin.isatty() if interactive is None else interactive
    if not is_interactive:
        return "skipped", "non-interactive init"
    answer = input(f"Adicionar agent-kit ao PATH em {profile}? [y/N]: ").strip().lower()
    if answer not in {"y", "yes", "s", "sim"}:
        return "declined", str(profile)
    block = "\n".join((
        SHELL_PATH_MARKER_START,
        f"export PATH={shlex.quote(binary_dir)}:$PATH",
        SHELL_PATH_MARKER_END,
    ))
    prefix = "" if not text or text.endswith("\n") else "\n"
    try:
        profile.parent.mkdir(parents=True, exist_ok=True)
        with profile.open("a", encoding="utf-8") as stream:
            stream.write(prefix + block + "\n")
    except OSError as error:
        return "error", str(error)
    return "added", str(profile)


def open_tasks(root: Path, features_root: Path, feature: str | None, statuses: set[str]) -> list[dict]:
    if feature:
        if not activity_runtime.SAFE_ID.fullmatch(feature):
            fail(f"invalid feature id: {feature}")
        directories = [features_root / feature]
        if not directories[0].is_dir():
            fail(f"feature not found: {feature}")
    else:
        directories = sorted(path for path in features_root.glob("*") if path.is_dir()) if features_root.is_dir() else []
    rows: list[dict] = []
    for directory in directories:
        state_path = directory / "state.json"
        if not state_path.is_file():
            continue
        try:
            state = json.loads(state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            fail(f"invalid state file {state_path}: {error}")
        errors = activity_runtime.routing.state_tool.validate_state(state, expected_feature=directory.name)
        if errors:
            fail(f"invalid state file {state_path}: " + "; ".join(errors))
        titles: dict[str, str] = {}
        tasks_path = directory / "tasks.md"
        if tasks_path.is_file():
            try:
                titles = {
                    match.group(1): match.group(2).strip()
                    for match in activity_runtime.routing.TASK_HEADER.finditer(tasks_path.read_text(encoding="utf-8"))
                }
            except (OSError, UnicodeError) as error:
                fail(f"cannot read task definitions {tasks_path}: {error}")
        for task_id, raw_task in sorted(state.get("tasks", {}).items()):
            task = raw_task if isinstance(raw_task, dict) else {"status": raw_task}
            status = task.get("status")
            if status not in statuses:
                continue
            rows.append({
                "feature": directory.name,
                "task": task_id,
                "title": titles.get(task_id),
                "status": status,
                "complexity": task.get("complexity"),
                "risk": task.get("risk"),
                "modelClass": task.get("modelClass"),
                "blockReason": task.get("blockReason"),
                "current": state.get("currentTask") == task_id,
            })
    return rows


def static_providers_for(harness: str) -> set[str]:
    """Providers with static template candidates for a harness."""
    return {
        "opencode": set(OPENCODE_STATIC_PROVIDERS),
        "codex": {"openai"},
        "copilot": {"copilot"},
        "claude": {"claude"},
    }.get(harness, {harness})


def provider_needs_discovery(harness: str, provider: str | None) -> bool:
    """A non-statically-covered provider requires live model discovery."""
    return bool(provider) and provider not in static_providers_for(harness)


def probe_allowed_provider(root: Path, data: dict, provider: str) -> dict:
    """Best availability probe for a provider across harnesses that serve it.

    A provider static for every selected harness needs no live probe; when
    several harnesses can serve it (e.g. copilot via the copilot harness or
    via opencode), the best state wins. Secret-free: IDs and counts only.
    """
    candidates = [
        harness for harness in data["harnesses"]
        if provider not in static_providers_for(harness)
    ]
    if not candidates:
        return {"harness": data["harnesses"][0], "provider": provider, "state": "configured", "models": []}
    order = {"available": 0, "no-models": 1, "provider-unavailable": 2, "harness-missing": 3}
    probes = [model_catalog.provider_discovery_status(root, harness, provider) for harness in candidates]
    return min(probes, key=lambda status: order[status["state"]])


def missing_provider_models_error(harnesses: list[str], catalog_value: dict | None, policy: dict) -> str | None:
    """Actionable error when a strict policy's providers have no models.

    Replaces the cryptic catalog validation message with the missing
    provider, what was actually found, and how to remediate (authenticate
    in the harness, verify entitlement, or inject discovery for CI).
    Secret-free: only provider IDs and counts, never credentials.
    """
    normalized = manifest_provider({"provider": policy} if policy else {})
    allowed = normalized.get("allowed") if normalized.get("strict") else None
    if not allowed:
        return None
    for harness in harnesses:
        needs = [item for item in allowed if item not in static_providers_for(harness)]
        if not needs:
            continue
        models = []
        if isinstance(catalog_value, dict):
            models = catalog_value.get("harnesses", {}).get(harness, {}).get("models", [])
        found = sorted({value.get("provider") for value in models if isinstance(value, dict) and value.get("provider")})
        if not any(item in found for item in needs):
            return (
                f"no models for provider(s) {needs} discovered on harness {harness!r} "
                f"(found providers: {found or ['none']}). Authenticate the provider in {harness} "
                f"(`{harness} auth login`), verify its entitlement, then retry with --discover-models. "
                f"For non-interactive runs without harness auth, set AGENT_KIT_{harness.upper()}_MODELS."
            )
    return None


def command_init(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    if not root.is_dir():
        fail(f"not a repository directory: {root}")
    existing: dict | None = None
    manifest_was_valid = False
    if manifest_path(root).is_file():
        try:
            existing = parse_manifest(root)
            manifest_was_valid = True
        except SystemExit:
            if not args.force or args.profile is None:
                raise
    profile = args.profile or (existing.get("profile") if existing else None)
    if not isinstance(profile, str):
        fail("init requires --profile when no valid manifest exists")
    profile_path(profile)
    if args.force and not manifest_was_valid and not args.harness:
        fail("init --force requires at least one --harness when no valid manifest exists")
    harnesses = args.harness or (list(existing["harnesses"]) if existing else ["codex", "opencode"])
    requested_provider: str | None = getattr(args, "provider", None)
    if requested_provider is not None and requested_provider not in MANIFEST_PROVIDERS:
        fail(f"unsupported provider: {requested_provider}")
    existing_policy = manifest_provider(existing) if isinstance(existing, dict) else {"default": None, "allowed": None, "strict": False}
    if requested_provider is not None:
        provider_default: str | None = requested_provider
        provider_allowed: list[str] | None = [requested_provider]
        provider_strict: bool | None = True
    elif args.force and isinstance(existing, dict) and (existing_policy.get("default") or existing_policy.get("allowed")):
        # Reuse the persisted provider policy, like other persisted settings.
        provider_default = existing_policy.get("default")
        provider_allowed = existing_policy.get("allowed")
        provider_strict = existing_policy.get("strict", True)
    else:
        provider_default = provider_allowed = None
        provider_strict = None
    effective_provider = provider_default or (existing_policy.get("default") if args.force else None)
    if effective_provider and any(provider_needs_discovery(harness, effective_provider) for harness in harnesses):
        args.discover_models = True
    staged_catalog: dict | None = None
    staged_catalog_status = "refreshed"
    staged_orchestrator: str | None = None
    if args.force:
        configured_orchestrator = (
            existing.get("orchestrator_model")
            if existing is not None and not args.harness and args.orchestrator_model is None
            else None
        )
        preflight_policy: dict | None = None
        if effective_provider:
            preflight_policy = {"default": effective_provider, "allowed": [effective_provider], "strict": True}
        staged_catalog, staged_catalog_status, staged_orchestrator = preflight_reinstall_catalog(
            root, profile, harnesses, args, configured_orchestrator, provider_policy=preflight_policy,
        )
    backup: Path | None = None
    inventory: dict[str, str] = {}
    if args.force:
        staged_extras = adapter_extra_models(
            "opencode",
            {"harnesses": harnesses, **({"provider": preflight_policy} if preflight_policy else {})},
            staged_catalog,
        ) if "opencode" in harnesses else []
        staged_options = {
            "extra_models": staged_extras or None,
            "allowed_providers": (preflight_policy["allowed"] if preflight_policy else None),
        }
        affected = reinstall_paths(
            root, sorted(set((*harnesses, *((existing or {}).get("harnesses", []))))),
            **staged_options,
        )
        print("INIT_FORCE_PATHS:")
        for path in affected:
            print(f"- {path.relative_to(root)}")
        if not args.yes:
            if not sys.stdin.isatty():
                fail("init --force requires --yes in non-interactive mode")
            if input("Reinstall framework-owned configuration? [y/N]: ").strip().lower() not in {"y", "yes"}:
                fail("init --force cancelled")
        backup, inventory = create_reinstall_backup(root, affected)
        print(f"REINSTALL_BACKUP: {backup.relative_to(root)}")
    try:
        write_manifest(
            root, profile, harnesses, force=args.force,
            orchestrator_model=staged_orchestrator or args.orchestrator_model,
            provider_default=provider_default,
            provider_allowed=provider_allowed,
            provider_strict=provider_strict,
        )
        data = parse_manifest(root)
        policy = manifest_provider(data)
        copy_assets(root, profile, force=args.force)
        changed = sync_agents(root, backup=True, force=args.force)
        adapters = sync_harness_adapters(root, data, replace_managed=args.force, **adapter_template_options("opencode", data, staged_catalog))
        removed_adapters = prune_obsolete_managed_adapters(root, data) if args.force else []
        commands = sync_opencode_commands(root, data, backup=True, force=args.force)
        if staged_catalog is not None:
            model_catalog.write_catalog(root, staged_catalog)
            catalog_status, catalog = staged_catalog_status, staged_catalog
        else:
            catalog_status, catalog = ensure_model_catalog(root, data, args, force=args.force)
        options = adapter_template_options("opencode", data, catalog)
        if options["extra_models"] or options["allowed_providers"]:
            adapters = sorted(set((*adapters, *sync_harness_adapters(root, data, replace_managed=args.force, **options))))
        # A provider policy change obsoletes disallowed managed files even
        # outside --force; prune only ledger-owned paths, never project files.
        if args.force or options["allowed_providers"]:
            removed_adapters = sorted(set((*removed_adapters, *prune_obsolete_managed_adapters(root, data, **options))))
        orchestrator_model = select_orchestrator_model(
            root, data, catalog, staged_orchestrator or args.orchestrator_model,
        )
        persist_orchestrator_model(root, orchestrator_model)
        data = parse_manifest(root)
        aligned_adapters = sync_harness_adapters(root, data, replace_managed=args.force, **adapter_template_options("opencode", data, catalog))
        adapters = sorted(set((*adapters, *aligned_adapters)))
        memory_status, memory_detail = ensure_ai_memory_config(root, data, args)
        print(f"MODEL_CATALOG: {catalog_status} ({catalog['fingerprint'][:12]})")
        print(f"ORCHESTRATOR_MODEL: {orchestrator_model}")
        if policy.get("default") or policy.get("allowed"):
            print(f"PROVIDER: default={policy.get('default')} allowed={policy.get('allowed')} strict={str(policy.get('strict')).lower()}")
        print(f"AI_MEMORY: {memory_status}" + (f" ({memory_detail})" if memory_detail else ""))
        if args.force:
            command_doctor(args)
    except BaseException:
        if backup is not None:
            restore_reinstall_backup(root, backup, inventory)
            print(f"INIT_FORCE_ROLLBACK: {backup.relative_to(root)}", file=sys.stderr)
        raise
    print(f"INIT: {root}")
    print(f"PROFILE: {profile}")
    print(f"AGENTS: {'updated' if changed else 'unchanged'}")
    print(f"HARNESS_ADAPTERS: {len(adapters)} updated")
    if args.force:
        print(f"OBSOLETE_ADAPTERS: {len(removed_adapters)} removed")
    print(f"OPENCODE_COMMANDS: {','.join(commands) if commands else 'unchanged'}")
    if args.force:
        print("INIT_FORCE: complete")
    shell_status, shell_detail = ensure_agent_kit_shell_path()
    print(f"SHELL_PATH: {shell_status}" + (f" ({shell_detail})" if shell_detail else ""))


def command_sync(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    copy_assets(root, data["profile"])
    changed = sync_agents(root, backup=False)
    try:
        existing_lock = model_catalog.load_catalog(root)
    except ValueError:
        existing_lock = None
    adapters = sync_harness_adapters(root, data, replace_managed=args.replace_managed, **adapter_template_options("opencode", data, existing_lock))
    commands = sync_opencode_commands(root, data, backup=False)
    catalog_status, catalog = ensure_model_catalog(root, data, args)
    options = adapter_template_options("opencode", data, catalog)
    if options["extra_models"] or options["allowed_providers"]:
        adapters = sorted(set((*adapters, *sync_harness_adapters(root, data, replace_managed=args.replace_managed, **options))))
    orchestrator_model = select_orchestrator_model(root, data, catalog, None)
    persist_orchestrator_model(root, orchestrator_model)
    data = parse_manifest(root)
    aligned_adapters = sync_harness_adapters(root, data, replace_managed=args.replace_managed, **adapter_template_options("opencode", data, catalog))
    adapters = sorted(set((*adapters, *aligned_adapters)))
    memory_status, memory_detail = ensure_ai_memory_config(root, data, args)
    print(f"SYNC: {root}")
    print(f"MODEL_CATALOG: {catalog_status} ({catalog['fingerprint'][:12]})")
    print(f"ORCHESTRATOR_MODEL: {orchestrator_model}")
    print(f"AI_MEMORY: {memory_status}" + (f" ({memory_detail})" if memory_detail else ""))
    print(f"AGENTS: {'updated' if changed else 'unchanged'}")
    print(f"HARNESS_ADAPTERS: {len(adapters)} updated")
    print(f"OPENCODE_COMMANDS: {','.join(commands) if commands else 'unchanged'}")


def iter_route_candidates(mapping: dict) -> list[tuple[str, str, dict]]:
    """Flatten a harness routing map to (family, class, candidate) triples."""
    rows: list[tuple[str, str, dict]] = []
    if not isinstance(mapping, dict):
        return rows
    for family in ("modelClasses", "reviewClasses", "qaClasses"):
        entries = mapping.get(family, {})
        if not isinstance(entries, dict):
            continue
        for class_name, value in entries.items():
            if not isinstance(value, dict):
                continue
            candidates = value.get("candidates")
            options = candidates if isinstance(candidates, list) else [value]
            for option in options:
                if isinstance(option, dict):
                    rows.append((family, str(class_name), option))
    return rows


def check_forbidden_routes(root: Path, data: dict, allowed: list[str]) -> list[str]:
    """A strict project must have no executable route outside allowed providers."""
    problems: list[str] = []
    for harness in data["harnesses"]:
        path = root / HARNESS_DIRS[harness] / "routing.json"
        try:
            mapping = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        for family, class_name, option in iter_route_candidates(mapping):
            provider = option.get("provider", harness)
            if provider not in allowed:
                problems.append(
                    f"FORBIDDEN_ROUTE: {harness}.{family}.{class_name} uses provider {provider!r} (allowed={allowed})"
                )
    return problems


def check_executable_routes(root: Path, data: dict, catalog: dict, allowed: list[str]) -> list[str]:
    """The control harness must offer at least one allowed, available route per plane."""
    problems: list[str] = []
    primary = data["harnesses"][0]
    path = root / HARNESS_DIRS[primary] / "routing.json"
    try:
        mapping = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return [f"UNROUTABLE: {primary} routing map is missing or invalid"]
    available = {
        str(value.get("id"))
        for value in catalog.get("harnesses", {}).get(primary, {}).get("models", [])
        if isinstance(value, dict) and value.get("available", True) and value.get("provider") in allowed
    }
    for family, class_name in (("modelClasses", "strongest-appropriate"), ("modelClasses", "balanced-coding")):
        entry = mapping.get(family, {}).get(class_name, {}) if isinstance(mapping, dict) else {}
        candidates = entry.get("candidates") if isinstance(entry, dict) else None
        options = candidates if isinstance(candidates, list) else [entry]
        runnable = [
            option for option in options
            if isinstance(option, dict) and option.get("provider") in allowed and option.get("model") in available
        ]
        plane = "orchestrator" if class_name == "strongest-appropriate" else "developer"
        print(f"EXECUTION_ROUTE {plane}: {'ready' if runnable else 'missing'}")
        if not runnable:
            problems.append(f"UNROUTABLE: no allowed {allowed} route for {plane} on {primary}")
    return problems


def command_doctor(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    errors: list[str] = []
    warnings: list[str] = []
    try:
        data = parse_manifest(root)
    except SystemExit:
        raise
    profile = data["profile"]
    managed = root / MANAGED_REL
    if not managed.is_dir() or not (managed / "metadata.toml").is_file():
        errors.append("managed assets missing")
    else:
        expected = tree_digest(managed)
        meta = load_toml(managed / "metadata.toml")
        if meta.get("content_sha256") != expected:
            errors.append("managed assets stale or modified; run agent-kit sync")
        if not (managed / "profiles" / f"{profile}.md").is_file():
            errors.append(f"managed profile missing: {profile}")
        if not (managed / "skills" / "engineering-protocol" / "SKILL.md").is_file():
            errors.append("shared engineering-protocol missing")
        for name in ("README.md", "schema.json", "state.py", "validate_state.py"):
            if not (managed / "state" / name).is_file():
                errors.append(f"portable state asset missing: {name}")
        for workflow in WORKFLOWS:
            available = (managed / "workflows" / f"{workflow}.md").is_file()
            print(f"WORKFLOW {workflow}: {'ready' if available else 'missing'}")
            if not available:
                errors.append(f"shared workflow missing: {workflow}")
    state_settings = data.get("state", {})
    state_provider = state_settings.get("provider", "framework") if isinstance(state_settings, dict) else "framework"
    state_path = state_settings.get("path", ".specs/features") if isinstance(state_settings, dict) else ".specs/features"
    if state_provider == "project":
        command = state_settings.get("command") if isinstance(state_settings, dict) else None
        print(f"STATE: project-owned ({command or 'project routing'})")
    else:
        print(f"STATE: framework-ready ({state_path})")
    agents = root / "AGENTS.md"
    text = agents.read_text(encoding="utf-8") if agents.is_file() else ""
    if text.count(MARKER_START) != 1 or text.count(MARKER_END) != 1:
        errors.append("AGENTS.md managed block missing or malformed")
    memory = root / AI_MEMORY_FILE
    if data.get("ai_memory", True) is False:
        print("AI_MEMORY: disabled")
    else:
        memory_errors, memory_warnings = ai_memory_validation(memory)
        errors.extend(memory_errors)
        warnings.extend(memory_warnings)
        print(f"AI_MEMORY: {'invalid' if memory_errors else 'preserved'}")
    try:
        catalog = model_catalog.load_catalog(root)
        catalog_errors = model_catalog.validate_catalog(catalog, data["harnesses"])
    except ValueError as error:
        catalog = None
        catalog_errors = [str(error)]
    errors.extend(catalog_errors)
    print(f"MODEL_CATALOG: {'invalid' if catalog_errors else catalog['fingerprint'][:12]}")
    policy = manifest_provider(data)
    if policy.get("default") or policy.get("allowed"):
        print(f"PROVIDER: default={policy.get('default')} allowed={policy.get('allowed')} strict={str(policy.get('strict')).lower()}")
    else:
        print("PROVIDER: legacy (no project policy; omitted provider resolves to auto)")
    extras_by_harness: dict[str, dict] = {}
    if catalog is not None and not catalog_errors:
        try:
            orchestrator_model = select_orchestrator_model(root, data, catalog, None)
            print(f"ORCHESTRATOR_MODEL: {orchestrator_model}")
        except SystemExit:
            errors.append("ORCHESTRATOR_UNAVAILABLE")
        extras_by_harness["opencode"] = adapter_template_options("opencode", data, catalog)
        if policy.get("strict") and policy.get("allowed"):
            forbidden = check_forbidden_routes(root, data, policy["allowed"])
            for detail in forbidden:
                errors.append(detail)
            executable = check_executable_routes(root, data, catalog, policy["allowed"])
            for detail in executable:
                errors.append(detail)
        for provider in sorted(set(policy.get("allowed") or []) - OPENCODE_STATIC_PROVIDERS):
            status = probe_allowed_provider(root, data, provider)
            state = status["state"]
            print(f"PROVIDER_STATUS {provider}: {state} ({len(status['models'])} models)")
            if state == "harness-missing":
                warnings.append(f"{provider} probe skipped: control harness executable not found")
            elif state not in ("available", "configured"):
                errors.append(f"{provider.upper()}_PROVIDER_UNAVAILABLE: {state}")
    for harness in data["harnesses"]:
        adapter = managed / "harness" / f"{harness}.md"
        print(f"HARNESS {harness}: {'adapter-ready' if adapter.is_file() else 'missing-adapter'}")
        providers = configured_providers(root, harness)
        print(f"PROVIDERS {harness}: {', '.join(providers) if providers else 'none-configured'}")
        if shutil.which(HARNESS_EXECUTABLES[harness]) is None:
            warnings.append(f"{HARNESS_EXECUTABLES[harness]} executable not found in PATH")
        if data.get("harness", {}).get("managed_adapters", True):
            expected_files = harness_templates(
                harness,
                profile=profile,
                orchestrator_model=data.get("orchestrator_model") if harness == data["harnesses"][0] else None,
                **extras_by_harness.get(harness, {}),
            )
            for relative, content in expected_files.items():
                target = root / HARNESS_DIRS[harness] / relative
                actual = target.read_text(encoding="utf-8") if target.is_file() else ""
                if actual != content:
                    errors.append(f"{harness} adapter missing or stale: {target.relative_to(root)}")
        if harness == "opencode":
            for workflow in WORKFLOWS:
                command = root / ".opencode" / "commands" / f"{workflow}.md"
                command_text = command.read_text(encoding="utf-8") if command.is_file() else ""
                ready = COMMAND_MARKER_START in command_text and COMMAND_MARKER_END in command_text
                print(f"OPENCODE_COMMAND /{workflow}: {'ready' if ready else 'missing'}")
                if not ready:
                    errors.append(f"OpenCode command missing or unmanaged: /{workflow}")
        if harness == "codex":
            for workflow in WORKFLOWS:
                prompt = Path.home() / ".codex" / "prompts" / f"{workflow}.md"
                prompt_text = prompt.read_text(encoding="utf-8") if prompt.is_file() else ""
                ready = COMMAND_MARKER_START in prompt_text and COMMAND_MARKER_END in prompt_text
                print(f"CODEX_PROMPT /prompts:{workflow}: {'ready' if ready else 'missing'}")
                if not ready:
                    warnings.append(f"Codex prompt unavailable: /prompts:{workflow}; run agent-kit install")
    for warning in warnings:
        print(f"WARN: {warning}")
    for error in errors:
        print(f"ERROR: {error}")
    if errors:
        raise SystemExit(1)
    print(f"DOCTOR: PASS profile={profile} framework={VERSION}")


def command_install(_: argparse.Namespace) -> None:
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f'framework_home = "{FRAMEWORK}"\nframework_version = "{VERSION}"\n', encoding="utf-8")
    prompts = sync_codex_prompts()
    print(f"INSTALL: {path}")
    print("DISCOVERY: consumers use managed skills via AGENTS.md; no consumer absolute path")
    print(f"CODEX_PROMPTS: {','.join(prompts) if prompts else 'unchanged'}")


def command_status(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    registry = config_path()
    print(f"FRAMEWORK: {VERSION}")
    print(f"PROFILE: {data['profile']}")
    print("PROTOCOL: engineering-protocol")
    print("WORKFLOWS: " + ", ".join(WORKFLOWS))
    print(f"REGISTRY: {'present' if registry.is_file() else 'missing'}")


def environment_requirements() -> tuple[environment_runtime.EnvironmentRequirement, ...]:
    """Keep the extensible environment registry at the CLI boundary."""
    return (
        environment_runtime.NodeToolingRequirement(),
        environment_runtime.AiMemoryRequirement(SUPPORTED_HARNESSES),
        environment_runtime.CavemanRequirement(SUPPORTED_HARNESSES),
        environment_runtime.TlcSpecDrivenRequirement(SUPPORTED_HARNESSES),
    )


def render_environment_report(report: environment_runtime.EnvironmentReport) -> str:
    """Render a compact, secret-free report for interactive terminal use."""
    lines = [
        "AGENT KIT ENVIRONMENT",
        f"PLATFORM: {report.platform.system} {report.platform.architecture}",
        "NODE: " + "  ".join((
            f"node={report.platform.node_version or 'missing'}",
            f"npm={report.platform.npm_version or 'missing'}",
            f"npx={report.platform.npx_version or 'missing'}",
        )),
    ]
    if report.harnesses:
        lines.append("HARNESS: " + "  ".join(
            f"{harness.id}={harness.status.value.upper()}"
            for harness in report.harnesses
        ))
    for requirement in report.requirements:
        version = f" version={requirement.version}" if requirement.version else ""
        lines.append(f"{requirement.name}: {requirement.status.value.upper()}{version}")
        for check in requirement.checks:
            qualifier = " optional" if not check.required else ""
            detail = f" ({check.detail})" if check.detail else ""
            lines.append(f"  - {check.label}: {check.status.value.upper()}{qualifier}{detail}")
    if report.operations:
        lines.append("OPERATIONS:")
        for operation in report.operations:
            detail = f" ({operation.detail})" if operation.detail else ""
            outcome = "OK" if operation.succeeded else "ERROR"
            lines.append(f"  - {operation.action_id}: {outcome}{detail}")
    lines.append("ENVIRONMENT: READY" if report.healthy else "ENVIRONMENT: ATTENTION REQUIRED")
    return "\n".join(lines)


def render_environment_actions(actions: tuple[environment_runtime.RepairAction, ...]) -> str:
    """Show every pre-authorized action before a repair may start."""
    lines = ["PLANNED CHANGES:"]
    for action in actions:
        lines.append(f"- {action.description}")
        lines.extend(f"  $ {command}" for command in action.preview)
    return "\n".join(lines)


def project_route_readiness(root: Path, data: dict, catalog: dict | None, allowed: list[str] | None) -> dict[str, bool]:
    """Per-plane executability within the allowed providers, secret-free."""
    planes = {
        "orchestrator": ("modelClasses", "strongest-appropriate"),
        "developer": ("modelClasses", "balanced-coding"),
        "reviewer": ("reviewClasses", "independent-reviewer"),
        "qa": ("qaClasses", "qa-targeted"),
    }
    primary = data["harnesses"][0]
    try:
        mapping = json.loads((root / HARNESS_DIRS[primary] / "routing.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {plane: False for plane in planes}
    available = set()
    if isinstance(catalog, dict):
        available = {
            str(value.get("id"))
            for value in catalog.get("harnesses", {}).get(primary, {}).get("models", [])
            if isinstance(value, dict) and value.get("available", True)
            and (allowed is None or value.get("provider") in allowed)
        }
    readiness: dict[str, bool] = {}
    for plane, (family, class_name) in planes.items():
        entry = mapping.get(family, {}).get(class_name, {}) if isinstance(mapping, dict) else {}
        candidates = entry.get("candidates") if isinstance(entry, dict) else None
        options = candidates if isinstance(candidates, list) else [entry]
        readiness[plane] = any(
            isinstance(option, dict)
            and (allowed is None or option.get("provider", primary) in allowed)
            and option.get("model") in available
            for option in options
        )
    return readiness


def project_provider_report(root: Path) -> dict | None:
    """Project-scoped harness/provider/route diagnosis; None without a manifest.

    Never reads or prints credentials: availability comes from exit codes
    and model IDs only (see catalog.provider_discovery_status).
    """
    if not manifest_path(root).is_file():
        return None
    try:
        data = parse_manifest(root)
    except SystemExit:
        return None
    policy = manifest_provider(data)
    primary = data["harnesses"][0]
    harness_installed = shutil.which(HARNESS_EXECUTABLES[primary]) is not None
    if policy.get("allowed"):
        interest = list(policy["allowed"])
    elif policy.get("default"):
        interest = [policy["default"]]
    else:
        interest = sorted(set(configured_providers(root, primary))) or [primary]
    try:
        catalog = model_catalog.load_catalog(root)
        catalog_errors = model_catalog.validate_catalog(catalog, data["harnesses"])
        if catalog_errors:
            catalog = None
    except ValueError:
        catalog = None
    providers = []
    for provider in interest:
        if not harness_installed:
            state, count = "harness-missing", 0
        elif provider in static_providers_for(primary):
            state, count = "configured", 0
        else:
            status = probe_allowed_provider(root, data, provider)
            state, count = status["state"], len(status["models"])
        providers.append({"provider": provider, "state": state, "models": count})
    routes = project_route_readiness(root, data, catalog, policy.get("allowed"))
    healthy = (
        harness_installed
        and all(item["state"] in ("available", "configured") for item in providers)
        and all(routes.values())
    )
    return {
        "harness": {"id": primary, "installed": harness_installed},
        "policy": policy,
        "providers": providers,
        "routes": routes,
        "catalog": "ready" if catalog is not None else "missing",
        "healthy": healthy,
    }


def render_project_report(report: dict) -> str:
    lines = ["PROJECT EXECUTION"]
    harness = report["harness"]
    lines.append(f"HARNESS {harness['id']}: {'OK' if harness['installed'] else 'MISSING'}")
    policy = report["policy"]
    if policy.get("default") or policy.get("allowed"):
        lines.append(f"PROVIDER POLICY: default={policy.get('default')} allowed={policy.get('allowed')} strict={str(policy.get('strict')).lower()}")
    else:
        lines.append("PROVIDER POLICY: legacy (omitted provider resolves to auto)")
    for item in report["providers"]:
        detail = f"{item['models']} models" if item["state"] == "available" else item["state"]
        lines.append(f"PROVIDER {item['provider']}: {item['state'].upper()} ({detail})")
    for plane, ready in report["routes"].items():
        lines.append(f"EXECUTION ROUTE {plane}: {'OK' if ready else 'MISSING'}")
    lines.append("PROJECT: READY" if report["healthy"] else "PROJECT: ATTENTION REQUIRED")
    return "\n".join(lines)


def command_env(args: argparse.Namespace) -> None:
    """Diagnose local prerequisites and repair only explicitly approved actions."""
    if args.json and args.yes:
        fail("env --json cannot be combined with --yes because JSON never changes the environment")
    root = Path(args.root).resolve()
    context = environment_runtime.EnvironmentContext.current(root)
    service = environment_runtime.EnvironmentService(
        context,
        environment_requirements(),
        harnesses=SUPPORTED_HARNESSES,
    )
    report = service.inspect()
    project = project_provider_report(root)
    if args.json:
        payload = report.to_dict()
        if project is not None:
            payload["project"] = project
        print(json.dumps(payload, indent=2, ensure_ascii=False, sort_keys=True))
        if not report.healthy or (project is not None and not project["healthy"]):
            raise SystemExit(1)
        return
    print(render_environment_report(report))
    if project is not None:
        print(render_project_report(project))
    if report.healthy and (project is None or project["healthy"]):
        return
    if args.check:
        raise SystemExit(1)
    if not report.actions:
        print("NO SAFE AUTOMATIC REPAIR: install missing prerequisites, then run agent-kit env --check.")
        raise SystemExit(1)
    print(render_environment_actions(report.actions))
    approved = args.yes
    if args.yes:
        print("APPROVAL: --yes")
    elif not sys.stdin.isatty():
        print("INTERACTION_REQUIRED: review the planned changes and rerun with --yes to approve them.")
        raise SystemExit(1)
    else:
        answer = input("Apply these changes? [y/N]: ").strip().lower()
        approved = answer in {"y", "yes", "s", "sim"}
    if not approved:
        print("NO CHANGES MADE.")
        raise SystemExit(1)
    operations = service.repair(report)
    report = replace(service.inspect(), operations=operations)
    print(render_environment_report(report))
    if not report.healthy:
        raise SystemExit(1)


def command_catalog(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    if args.catalog_command == "refresh":
        try:
            value = model_catalog.refresh(
                root, args.harness or data["harnesses"],
                discover=not args.configured_only, merge=bool(args.harness),
            )
        except ValueError as error:
            fail(str(error))
        selected = select_orchestrator_model(root, data, value, args.orchestrator_model)
        persist_orchestrator_model(root, selected)
        data = parse_manifest(root)
        sync_harness_adapters(root, data, replace_managed=False, **adapter_template_options("opencode", data, value))
    else:
        try:
            value = model_catalog.load_catalog(root)
        except ValueError as error:
            fail(str(error))
    print(json.dumps(value, indent=2, sort_keys=True))


def print_model_proposal(proposal: dict) -> None:
    print(f"MODEL_PROPOSAL: {proposal['proposalId']} harness={proposal['harness']} provider={proposal['provider']}")
    print("ROLE\tRECOMMENDED\tPROVIDER\tEFFORT\tESTIMATE\tFLOOR")
    for role in proposal["roles"]:
        recommended = role["recommended"]
        estimate = recommended["estimate"]
        tokens = estimate.get("tokens")
        cost = estimate.get("costMicrounits")
        rendered = f"{tokens} tokens" if tokens is not None else "unknown tokens"
        if cost is not None:
            rendered += f"/{cost} microunits"
        print("\t".join((role["role"], recommended["model"], str(recommended["provider"]), recommended["reasoningEffort"], rendered, role["floor"])))
        for alternative in role["alternatives"]:
            state = "eligible" if alternative["eligible"] else f"disabled: {alternative['disabledReason']}"
            print(f"  - {alternative['model']} [{alternative['provider']}] {state}")
    print(f"APPROVE: agent-kit {proposal['workflow']} --approve {proposal['proposalId']}")


def interactive_model_approval(proposal: dict) -> list[str] | None:
    while True:
        print("ACTIONS: 1=approve 2=change-models 3=show-justification 4=cancel")
        choice = input("Select action [1]: ").strip() or "1"
        if choice == "1":
            return []
        if choice == "2":
            overrides: list[str] = []
            for contract in proposal["roles"]:
                if contract.get("locked"):
                    continue
                eligible = [value for value in contract["alternatives"] if value.get("eligible")]
                print(f"{contract['role']} models:")
                for index, candidate in enumerate(eligible, 1):
                    marker = " (recommended)" if candidate["model"] == contract["recommended"]["model"] else ""
                    print(f"  {index}. {candidate['model']} [{candidate['provider']}]{marker}")
                selected = input(f"Select {contract['role']} [recommended]: ").strip()
                if not selected:
                    continue
                if not selected.isdigit() or not 1 <= int(selected) <= len(eligible):
                    print("Invalid selection; no dispatch plan created.")
                    return None
                overrides.append(f"{contract['role']}={eligible[int(selected) - 1]['model']}")
            return overrides
        if choice == "3":
            for contract in proposal["roles"]:
                print(f"- {contract['role']}: {contract['justification']}")
            continue
        if choice == "4":
            return None
        print("Invalid action.")


def command_activity(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    os.environ["AGENT_FRAMEWORK_CONSUMER_ROOT"] = str(root)
    try:
        if args.approve:
            value = activity_runtime.approve_proposal(root, args.approve, args.model)
        else:
            if not args.target:
                fail(f"{args.command} requires a task, feature, or intent when creating a proposal")
            proposal = activity_runtime.create_proposal(
                root, data, args.command, args.target, args.provider, args.harness,
            )
            if args.propose:
                value = proposal
            elif args.yes:
                value = activity_runtime.approve_proposal(root, proposal["proposalId"], args.model)
            elif not sys.stdin.isatty():
                fail(f"INTERACTION_REQUIRED: inspect proposal {proposal['proposalId']} and approve it explicitly")
            else:
                print_model_proposal(proposal)
                selections = interactive_model_approval(proposal)
                if selections is None:
                    fail("activity cancelled; proposal remains available for explicit approval")
                value = activity_runtime.approve_proposal(root, proposal["proposalId"], [*args.model, *selections])
    except ValueError as error:
        fail(str(error))
    if args.json:
        print(json.dumps(value, indent=2, sort_keys=True))
    elif value.get("kind") == "ModelProposal":
        print_model_proposal(value)
    else:
        print(f"DISPATCH_PLAN: {value['planId']} APPROVED")


def command_dispatch(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    os.environ["AGENT_FRAMEWORK_CONSUMER_ROOT"] = str(root)
    try:
        if args.dispatch_command == "next-fallback":
            value = activity_runtime.next_fallback(root, args.plan, args.role, args.failed_model)
        else:
            value = activity_runtime.record_receipt(
                root, args.plan, args.role, args.result, args.effective_model,
                args.input_tokens, args.output_tokens, args.cost_microunits,
                args.cache_tokens, args.gate,
            )
    except ValueError as error:
        fail(str(error))
    if args.json:
        print(json.dumps(value, indent=2, sort_keys=True))
    elif args.dispatch_command == "next-fallback":
        print(f"APPROVED_FALLBACK: {value['model']} provider={value['provider']} agent={value['agent']}")
    else:
        print(f"DISPATCH_RECEIPT: {args.plan} {args.role} {args.result}")


def command_usage(args: argparse.Namespace) -> None:
    value = activity_runtime.usage_report(Path(args.root).resolve())
    if args.json:
        print(json.dumps(value, indent=2, sort_keys=True))
        return
    print(f"USAGE: {sum(item['runs'] for item in value['models'].values())} run(s); costUnknown={str(value['costUnknown']).lower()}")
    for model, totals in sorted(value["models"].items()):
        print(f"- {model}: runs={totals['runs']} input={totals['inputTokens']} output={totals['outputTokens']} cache={totals['cacheTokens']} costMicrounits={totals['costMicrounits']}")


def command_tasks(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    state_settings = data.get("state", {}) if isinstance(data.get("state", {}), dict) else {}
    relative_state_path = Path(str(state_settings.get("path", ".specs/features")))
    if relative_state_path.is_absolute() or ".." in relative_state_path.parts:
        fail("state.path must stay inside the project")
    features_root = root / relative_state_path
    if args.status:
        statuses = set(args.status)
    elif args.all:
        statuses = set(activity_runtime.routing.state_tool.TASK_STATUSES)
        statuses.update(activity_runtime.routing.state_tool.LEGACY_TASK_STATUSES)
    else:
        statuses = set(OPEN_TASK_STATUSES)
    rows = open_tasks(root, features_root, args.feature, statuses)
    if args.json:
        print(json.dumps({
            "schemaVersion": 1,
            "kind": "TaskList",
            "feature": args.feature,
            "statePath": relative_state_path.as_posix(),
            "statuses": sorted(statuses),
            "tasks": rows,
        }, indent=2, ensure_ascii=False, sort_keys=True))
        return
    print(f"OPEN_TASKS: {len(rows)}")
    if not rows:
        return
    print("FEATURE\tTASK\tSTATUS\tCOMPLEXITY\tRISK\tTITLE")
    for row in rows:
        current = "*" if row["current"] else ""
        print("\t".join((
            row["feature"], row["task"] + current, str(row["status"]),
            str(row["complexity"] or "-"), str(row["risk"] or "-"),
            str(row["title"] or "-"),
        )))


def command_route(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    os.environ["AGENT_FRAMEWORK_CONSUMER_ROOT"] = str(root)
    try:
        value = activity_runtime.create_proposal(root, data, args.workflow, args.target, args.provider, args.harness)
    except ValueError as error:
        fail(str(error))
    if args.json or args.route_command == "simulate":
        print(json.dumps(value, indent=2, sort_keys=True))
    else:
        print_model_proposal(value)


def command_diff(args: argparse.Namespace) -> None:
    root = Path(args.root).resolve()
    data = parse_manifest(root)
    managed = root / MANAGED_REL
    current = tree_digest(managed) if managed.is_dir() else None
    expected = expected_digest(data["profile"])
    print(f"MANAGED_ASSETS: {'change' if current != expected else 'unchanged'}")
    agents = (root / "AGENTS.md").read_text(encoding="utf-8") if (root / "AGENTS.md").is_file() else ""
    print(f"AGENTS_BLOCK: {'present' if agents.count(MARKER_START) == agents.count(MARKER_END) == 1 else 'change'}")
    if data.get("ai_memory", True) is False:
        print("AI_MEMORY: disabled")
    elif not (root / AI_MEMORY_FILE).is_file():
        print("AI_MEMORY: create")
    else:
        memory_errors, _memory_warnings = ai_memory_validation(root / AI_MEMORY_FILE)
        print(f"AI_MEMORY: {'invalid' if memory_errors else 'preserve'}")
    try:
        catalog = model_catalog.load_catalog(root)
        catalog_errors = model_catalog.validate_catalog(catalog, data["harnesses"])
        print(f"MODEL_CATALOG: {'invalid' if catalog_errors else 'preserve'}")
    except ValueError:
        catalog = None
        print("MODEL_CATALOG: create")
    if "opencode" in data["harnesses"]:
        for workflow in WORKFLOWS:
            target = root / ".opencode" / "commands" / f"{workflow}.md"
            current = target.read_text(encoding="utf-8") if target.is_file() else ""
            expected = managed_command(workflow, WORKFLOWS[workflow], project_workflow_hook(data, workflow))
            print(f"OPENCODE_COMMAND /{workflow}: {'unchanged' if current == expected else 'change'}")
    if data.get("harness", {}).get("managed_adapters", True):
        for harness in data["harnesses"]:
            changes = sum(
                1
                for relative, content in harness_templates(
                    harness,
                    profile=data["profile"],
                    orchestrator_model=data.get("orchestrator_model") if harness == data["harnesses"][0] else None,
                    **adapter_template_options(harness, data, catalog),
                ).items()
                if not (root / HARNESS_DIRS[harness] / relative).is_file()
                or (root / HARNESS_DIRS[harness] / relative).read_text(encoding="utf-8") != content
            )
            print(f"{harness.upper()}_ADAPTERS: {'change' if changes else 'unchanged'}")
    else:
        print("HARNESS_ADAPTERS: project override")


def main() -> None:
    parser = argparse.ArgumentParser(prog="agent-kit")
    parser.add_argument("--root", default=".", help="consumer repository")
    sub = parser.add_subparsers(dest="command", required=True)
    init = sub.add_parser("init")
    init.add_argument("--profile")
    init.add_argument("--harness", action="append", choices=SUPPORTED_HARNESSES)
    init.add_argument("--provider", choices=MANIFEST_PROVIDERS, help="default execution provider to validate and persist")
    init.add_argument("--force", action="store_true", help="back up and reinstall framework-owned project configuration")
    init.add_argument("--yes", action="store_true", help="approve a non-interactive forced reinstall")
    init.add_argument("--reuse-model-lock", action="store_true", help="reuse an existing valid model catalog lock")
    init.add_argument("--discover-models", action="store_true")
    init.add_argument("--orchestrator-model")
    init.add_argument("--memory-workspace")
    init.add_argument("--memory-project")
    init.set_defaults(func=command_init)
    sync = sub.add_parser("sync")
    sync.add_argument("--replace-managed", action="store_true", help="back up and restore modified framework-owned harness adapters")
    sync.add_argument("--memory-workspace")
    sync.add_argument("--memory-project")
    sync.add_argument("--refresh-models", action="store_true")
    sync.set_defaults(func=command_sync)
    doctor = sub.add_parser("doctor")
    doctor.set_defaults(func=command_doctor)
    install = sub.add_parser("install")
    install.set_defaults(func=command_install)
    status = sub.add_parser("status")
    status.set_defaults(func=command_status)
    env = sub.add_parser("env", help="check and repair local agent dependencies")
    env_mode = env.add_mutually_exclusive_group()
    env_mode.add_argument("--check", action="store_true", help="report only; do not prompt or change the machine")
    env_mode.add_argument("--yes", action="store_true", help="approve the displayed safe repair plan")
    env.add_argument("--json", action="store_true", help="emit structured report only; never change the machine")
    env.set_defaults(func=command_env)
    catalog = sub.add_parser("catalog")
    catalog_sub = catalog.add_subparsers(dest="catalog_command", required=True)
    catalog_refresh = catalog_sub.add_parser("refresh")
    catalog_refresh.add_argument("--harness", action="append", choices=SUPPORTED_HARNESSES)
    catalog_refresh.add_argument("--configured-only", action="store_true")
    catalog_refresh.add_argument("--orchestrator-model")
    catalog_sub.add_parser("show")
    catalog.set_defaults(func=command_catalog)
    diff = sub.add_parser("diff")
    diff.set_defaults(func=command_diff)
    for workflow in WORKFLOWS:
        activity = sub.add_parser(workflow)
        activity.add_argument("target", nargs="?")
        activity.add_argument("--provider", choices=("auto", "openai", "opencode", "openrouter", "copilot", "claude"), default=None, help="execution provider; omitted uses the project default when configured")
        activity.add_argument("--harness", choices=SUPPORTED_HARNESSES)
        activity.add_argument("--propose", action="store_true")
        activity.add_argument("--approve")
        activity.add_argument("--model", action="append", default=[])
        activity.add_argument("--yes", action="store_true")
        activity.add_argument("--json", action="store_true")
        activity.set_defaults(func=command_activity)
    dispatch = sub.add_parser("dispatch")
    dispatch_sub = dispatch.add_subparsers(dest="dispatch_command", required=True)
    dispatch_record = dispatch_sub.add_parser("record")
    dispatch_record.add_argument("--plan", required=True)
    dispatch_record.add_argument("--role", choices=activity_runtime.ROLE_ORDER, required=True)
    dispatch_record.add_argument("--result", choices=tuple(sorted(activity_runtime.SAFE_RESULT)), required=True)
    dispatch_record.add_argument("--effective-model", required=True)
    dispatch_record.add_argument("--input-tokens", type=int)
    dispatch_record.add_argument("--output-tokens", type=int)
    dispatch_record.add_argument("--cache-tokens", type=int)
    dispatch_record.add_argument("--cost-microunits", type=int)
    dispatch_record.add_argument("--gate", action="append", default=[])
    dispatch_record.add_argument("--json", action="store_true")
    dispatch_fallback = dispatch_sub.add_parser("next-fallback")
    dispatch_fallback.add_argument("--plan", required=True)
    dispatch_fallback.add_argument("--role", choices=activity_runtime.ROLE_ORDER, required=True)
    dispatch_fallback.add_argument("--failed-model", required=True)
    dispatch_fallback.add_argument("--json", action="store_true")
    dispatch.set_defaults(func=command_dispatch)
    usage = sub.add_parser("usage")
    usage_sub = usage.add_subparsers(dest="usage_command", required=True)
    usage_report = usage_sub.add_parser("report")
    usage_report.add_argument("--json", action="store_true")
    usage.set_defaults(func=command_usage)
    tasks = sub.add_parser("tasks")
    tasks_sub = tasks.add_subparsers(dest="tasks_command", required=True)
    tasks_list = tasks_sub.add_parser("list")
    tasks_list.add_argument("--feature")
    task_filters = tasks_list.add_mutually_exclusive_group()
    task_filters.add_argument(
        "--status", action="append",
        choices=tuple(sorted(activity_runtime.routing.state_tool.TASK_STATUSES | activity_runtime.routing.state_tool.LEGACY_TASK_STATUSES)),
    )
    task_filters.add_argument("--all", action="store_true")
    tasks_list.add_argument("--json", action="store_true")
    tasks.set_defaults(func=command_tasks)
    route = sub.add_parser("route")
    route_sub = route.add_subparsers(dest="route_command", required=True)
    for route_name in ("explain", "simulate"):
        route_parser = route_sub.add_parser(route_name)
        route_parser.add_argument("target")
        route_parser.add_argument("--workflow", choices=tuple(WORKFLOWS), default="continue")
        route_parser.add_argument("--provider", choices=("auto", "openai", "opencode", "openrouter", "copilot", "claude"), default=None, help="execution provider; omitted uses the project default when configured")
        route_parser.add_argument("--harness", choices=SUPPORTED_HARNESSES)
        route_parser.add_argument("--json", action="store_true")
    route.set_defaults(func=command_route)
    version = sub.add_parser("version")
    version.set_defaults(func=lambda _: print(VERSION))
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
